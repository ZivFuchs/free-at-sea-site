{
	// Staging only: a password gate (src/gate.ts) in front of the prebuilt site. Build first with `build:staging`.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "free-at-sea-staging",
	"account_id": "08bc090346c8148fda3e357569782486",
	"compatibility_date": "2026-09-03",
	"main": "./src/gate.ts",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "staging.freeatseafilm.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
