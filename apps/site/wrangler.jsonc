{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"account_id": "08bc090346c8148fda3e357569782486",
	"name": "free-at-sea",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "freeatseafilm.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"routes": [
				{
					"pattern": "staging.freeatseafilm.com",
					"custom_domain": true
				}
			],
			"vars": {
				"NOINDEX": true,
				"EXPERIMENTS": true,
				"SANITY_PERSPECTIVE": "drafts"
			}
		}
	}
}
