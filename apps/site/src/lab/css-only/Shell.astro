---
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import LabLayout from "../LabLayout.astro";
import { styles } from "./CssOnly.styles";
import "./css-only.css";

/* Shared frame for the two pages: scroll-driven water backdrop, tide header, popover menu. No scripts. */
interface Props {
	/** Home hides the wordmark until the hero title has scrolled away. */
	home?: boolean;
}

const { home = false } = Astro.props;
const site = await getSite();
const base = "/lab/css-only";
const links = [
	{ label: "Clips", href: `${base}#clips` },
	{ label: "Press", href: `${base}#press` },
	{ label: "Newsletter", href: `${base}#newsletter` },
	{ label: "How", href: `${base}/about` },
];
const menuId = "nojs-menu";
---

<LabLayout slug="css-only">
	<div data-nojs="page" {...sx(styles.page)}>
		<div aria-hidden="true" data-nojs="backdrop" {...sx(styles.backdrop)}>
			<div data-nojs="shafts" {...sx(styles.shafts)}></div>
		</div>

		<header {...sx(styles.header)}>
			<div data-nojs="bar" {...sx(styles.bar)}>
				<span aria-hidden="true" data-nojs="tide wave" {...sx(styles.tide)} style="--w: 7rem; --h: 0.5rem"></span>
				<span aria-hidden="true" data-nojs="hairline" {...sx(styles.hairline)}></span>
				<nav aria-label="Main" {...sx(layout.container, styles.row)}>
					<a href={base} data-nojs={home ? "mark" : undefined} {...sx(styles.mark)}>{home ? site.title : "← Back"}</a>
					<ul {...sx(styles.links)}>
						{links.map(({ label, href }) => <li><a href={href} {...sx(styles.link)}>{label}</a></li>)}
					</ul>
					<button type="button" popovertarget={menuId} {...sx(styles.menuButton)}>Menu</button>
				</nav>
			</div>
		</header>
		<nav id={menuId} popover aria-label="Main" data-nojs="menu" {...sx(styles.menu)}>
			<ul>
				{links.map(({ label, href }) => <li><a href={href} {...sx(styles.menuLink)}>{label}</a></li>)}
			</ul>
		</nav>

		<slot />

		<p aria-hidden="true" data-nojs="gauge" {...sx(styles.gauge)}>Depth</p>
	</div>
</LabLayout>
