---
import { sx } from "@/lib/sx";
import { styles } from "./Titles.styles";

/* Text split into letters that can move apart: each carries `--i`, the wrapper `--mid` (the centre index). */
interface Props {
	text: string;
	as?: "credit" | "title";
}

const { text, as = "credit" } = Astro.props;
let index = 0;
const words = text.split(" ").map((word) => [...word].map((char) => ({ char, i: index++ })));
---

<span aria-hidden="true" style={{ "--mid": (index - 1) / 2 }}>{
	words.map((word, w) => (
		<Fragment>{w > 0 && " "}<span {...sx(styles.word)}>{word.map(({ char, i }) => (
			<span {...sx(as === "title" ? styles.titleLetter : styles.letter)} style={{ "--i": i }}>{char}</span>
		))}</span></Fragment>
	))
}</span>
