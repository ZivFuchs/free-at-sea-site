---
import LabLayout from "@/lab/LabLayout.astro";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { getReel, REEL } from "./content";
import { styles } from "./ReelShell.styles";
import "./transitions.css";

/* Shell of every Reel page: the persistent header, and the script that tells each cross-document view
 * transition which way it is going and which poster travels. */
interface Props {
	/** Id of an element late in the page: first paint (and the transition) waits for it to parse. */
	expect?: string;
}

const { expect } = Astro.props;
const [site, { clips, press }] = await Promise.all([getSite(), getReel()]);
const order = [...clips, ...press].map(({ path }) => path);
const NAV = [
	{ label: "Clips", href: `${REEL}/#clips`, wide: false },
	{ label: "Press", href: `${REEL}/#press`, wide: false },
	{ label: "Newsletter", href: `${REEL}/#newsletter`, wide: true },
];
---

<LabLayout slug="reel">
	<Fragment slot="head">
		{expect && <link rel="expect" href={`#${expect}`} blocking="render" />}
		<script is:inline define:vars={{ order, root: REEL }}>
			const path = (url) => new URL(url, location.href).pathname.replace(/\/$/, "");
			const kind = (p) => (p === root ? "home" : p.startsWith(`${root}/`) ? p.slice(root.length + 1).split("/")[0] : "out");
			/** Only the stop being opened or left carries the shared names, so the rest of the page moves as one. */
			const mark = (stop) => {
				for (const el of document.querySelectorAll("[data-vt-for]")) {
					el.style.viewTransitionName = el.dataset.vtFor === stop ? el.dataset.vt : "";
				}
			};
			const direction = (from, to) => {
				const a = kind(from);
				const b = kind(to);
				if (a === "home" && b !== "home" && b !== "out") return "dive";
				if (b === "home" && a !== "home" && a !== "out") return "surface";
				if (a === b && a !== "home" && a !== "out") return order.indexOf(to) > order.indexOf(from) ? "next" : "prev";
				return "drift";
			};
			addEventListener("pageswap", (event) => {
				if (event.viewTransition && event.activation) mark(path(event.activation.entry.url));
			});
			addEventListener("pagereveal", (event) => {
				mark(null);
				const from = self.navigation?.activation?.from;
				if (!event.viewTransition || !from) return;
				const origin = path(from.url);
				mark(origin);
				event.viewTransition.types.add(direction(origin, path(location.href)));
				event.viewTransition.finished.finally(() => mark(null));
			});
		</script>
	</Fragment>

	<header {...sx(styles.header)}>
		<div aria-hidden="true" {...sx(styles.glass)}></div>
		<nav aria-label="Main" {...sx(layout.container, styles.bar)}>
			<a href={`${REEL}/`} {...sx(styles.wordmark)}>{site.title}</a>
			<div {...sx(styles.nav)}>
				{NAV.map(({ label, href, wide }) => <a href={href} {...sx(styles.link, wide && styles.wide)}>{label}</a>)}
			</div>
		</nav>
	</header>
	<div aria-hidden="true" {...sx(styles.foam)}></div>
	<main>
		<slot />
	</main>
	<footer {...sx(styles.footer)}>© {new Date().getFullYear()} {site.title}</footer>
</LabLayout>
