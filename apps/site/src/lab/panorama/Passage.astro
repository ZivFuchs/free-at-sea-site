---
import type { Clip } from "@/lib/clips";
import { newsletterForm } from "@/lib/newsletter";
import type { PressItem } from "@/lib/press";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import { linkMarker, styles } from "./Passage.styles";
import { BANDS, CLOUDS, CREST, GLITTER, STARS, scallop } from "./scene";

/* The page as one sideways passage: 200 nautical miles from the coast to the high seas, dawn to night.
 * Each panel's `data-hour` (0 dawn … 4 night) sets the sky when it is centred; `data-mile` marks the log. */
interface Props {
	site: SiteSettings;
	clips: Clip[];
	press: PressItem[];
}

const { site, clips, press } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const HOURS = ["dawn", "day", "gold", "dusk", "night"] as const;
const NAV = [
	{ label: "Clips", to: "clips" },
	{ label: "Press", to: "press" },
	{ label: "Newsletter", to: "newsletter" },
];
const BUOYS = {
	territorial: {
		mile: 12,
		zone: "Territorial sea ends",
		line: "Astern, a nation's full law. It stops here.",
	},
	contiguous: { mile: 24, zone: "Contiguous zone ends", line: "Customs and patrols turn back." },
	economic: {
		mile: 200,
		zone: "Economic zone ends",
		line: "Past this mark the water is no one's. The high seas.",
	},
};
---

<section aria-label="The passage" data-passage {...sx(styles.root)}>
	<div data-stage {...sx(styles.stage)}>
		<div aria-hidden="true" {...sx(styles.layer)}>
			<div {...sx(styles.skyBox)}>
				{HOURS.map((hour) => <div data-hour-layer {...sx(styles.fill, styles[`${hour}Sky`])} />)}
				<div {...sx(styles.fill, styles.stars)}>
					<svg {...sx(styles.svg)}>
						{STARS.map(([x, y, r]) => <circle cx={`${x}%`} cy={`${y}%`} r={r} fill="currentColor" />)}
					</svg>
				</div>
				<div {...sx(styles.disc, styles.sun)}></div>
				<div {...sx(styles.disc, styles.moon)}></div>
				<div {...sx(styles.fill, styles.clouds)}>
					<svg {...sx(styles.svg)}>
						<pattern id="passage-clouds" data-drift="0.1" data-period={CLOUDS.period} width={CLOUDS.period} height="100%" patternUnits="userSpaceOnUse">
							{CLOUDS.bars.map(([x, y, w, h]) => <rect x={x} y={`${y}%`} width={w} height={h} rx={h / 2} fill="currentColor" />)}
						</pattern>
						<rect width="100%" height="100%" fill="url(#passage-clouds)" />
					</svg>
				</div>
			</div>
			<div {...sx(styles.seaBox)}>
				{HOURS.map((hour) => <div data-hour-layer {...sx(styles.fill, styles[`${hour}Sea`])} />)}
				<div {...sx(styles.glitter)}>
					<svg viewBox="0 0 100 100" preserveAspectRatio="none" {...sx(styles.svg)}>
						{GLITTER.map(([y, w]) => <rect x={50 - w / 2} y={y} width={w} height="1.1" fill="currentColor" />)}
					</svg>
				</div>
				{
					BANDS.map(({ id, period, height, drift, fill, stroke }) => (
						<div {...sx(styles.band, styles[id])}>
							<svg {...sx(styles.svg)}>
								<pattern id={`passage-${id}`} data-drift={drift} data-period={period} width={period} height="100%" patternUnits="userSpaceOnUse">
									<path d={`${scallop(period, height)} V400 H0 Z`} fill="currentColor" fill-opacity={fill} />
									<path d={scallop(period, height)} fill="none" stroke="currentColor" stroke-opacity={stroke} stroke-width="1.25" />
								</pattern>
								<rect width="100%" height="100%" fill={`url(#passage-${id})`} />
							</svg>
						</div>
					))
				}
			</div>
			<div {...sx(styles.horizon)}></div>
		</div>

		<div data-scroller {...sx(styles.scroller)}>
			<div data-track {...sx(styles.track)}>
				<div data-hour="0" {...sx(styles.panel, styles.wide)}>
					<div {...sx(styles.above)}>
						<h1 {...sx(styles.title)}>{site.title}</h1>
					</div>
					<div {...sx(styles.below)}>
						<p {...sx(styles.tagline)}>{site.tagline}</p>
						<p {...sx(styles.copy)}>A passage of two hundred nautical miles, from the coast to water no nation owns.</p>
						<p {...sx(styles.hint)}>Scroll to cast off →</p>
					</div>
				</div>

				<div data-hour="0.35" data-mile={BUOYS.territorial.mile} {...sx(styles.panel, styles.buoyPanel)}>
					<div {...sx(styles.above)}>
						<p {...sx(styles.numeral)}>{BUOYS.territorial.mile}</p>
						<p {...sx(styles.unit)}>Nautical miles</p>
						<svg viewBox="0 0 28 64" aria-hidden="true" {...sx(styles.buoy)}><use href="#passage-buoy" /></svg>
					</div>
					<div {...sx(styles.below)}>
						<p {...sx(styles.eyebrow)}>{BUOYS.territorial.zone}</p>
						<p {...sx(styles.copy)}>{BUOYS.territorial.line}</p>
					</div>
				</div>

				<div data-hour="0.7" {...sx(styles.panel, styles.bargePanel)}>
					<div {...sx(styles.above)}>
						<svg data-approach viewBox="0 0 240 56" role="img" aria-label="A barge on the horizon" {...sx(styles.barge, styles.approach)}>
							<path d="M4 44h232l-9 12H13z" fill="var(--hull)" />
							<path d="M4 44h232v2.5H4z" fill="var(--rust)" />
							<path d="M22 30h34v14H22zM60 30h34v14H60zM60 16h34v13H60zM98 30h34v14H98zM150 30h34v14h-34z" fill="var(--cargo)" />
							<path d="M22 36.5h34M60 36.5h34M60 22h34M98 36.5h34M150 36.5h34" stroke="var(--hull)" stroke-opacity="0.35" stroke-width="0.6" />
							<path d="M192 24h26v20h-26zM199 14h12v10h-12z" fill="var(--app-paper)" />
							<path d="M196 29h5v5h-5zM204 29h5v5h-5zM212 29h3v5h-3z" fill="var(--hull)" />
							<path d="M205 2v12M136 20v24M136 20l12 10" stroke="var(--hull)" stroke-width="1.2" fill="none" />
						</svg>
					</div>
					<div {...sx(styles.below)}>
						<p {...sx(styles.eyebrow)}>The film</p>
						<p {...sx(styles.copy)}>
							A documentary about seasteading: the attempt to build homes on the open ocean, beyond the reach of any shore.
						</p>
					</div>
				</div>

				<div data-hour="0.9" data-mile={BUOYS.contiguous.mile} {...sx(styles.panel, styles.buoyPanel)}>
					<div {...sx(styles.above)}>
						<p {...sx(styles.numeral)}>{BUOYS.contiguous.mile}</p>
						<p {...sx(styles.unit)}>Nautical miles</p>
						<svg viewBox="0 0 28 64" aria-hidden="true" {...sx(styles.buoy)}><use href="#passage-buoy" /></svg>
					</div>
					<div {...sx(styles.below)}>
						<p {...sx(styles.eyebrow)}>{BUOYS.contiguous.zone}</p>
						<p {...sx(styles.copy)}>{BUOYS.contiguous.line}</p>
					</div>
				</div>

				{
					clips.length > 0 && (
						<div data-hour="1" data-landfall="clips" {...sx(styles.panel, styles.headPanel)}>
							<div {...sx(styles.above)}>
								<h2 {...sx(styles.heading)}>Clips</h2>
							</div>
							<div {...sx(styles.below)}>
								<p {...sx(styles.eyebrow)}>From the film</p>
							</div>
						</div>
					)
				}
				{
					clips.map(({ title, url, thumbnail }, i) => (
						<a href={url} target="_blank" rel="noopener" data-hour="1.2" {...sx(linkMarker, styles.panel, styles.clipPanel, styles.link)}>
							<div {...sx(styles.above)}>
								<div {...sx(styles.screen)}>
									<div {...sx(styles.frame)}>
										{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" draggable="false" {...sx(styles.poster)} />}
										<span {...sx(styles.play)}>
											<svg viewBox="0 0 12 14" aria-hidden="true" {...sx(styles.triangle)}><path d="M0 0v14l12-7z" fill="currentColor" /></svg>
										</span>
									</div>
									<div {...sx(styles.poles)}><span {...sx(styles.pole)} /><span {...sx(styles.pole)} /></div>
								</div>
							</div>
							<div {...sx(styles.below)}>
								{thumbnail && <img src={thumbnail} alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false" {...sx(styles.reflection)} />}
								<div {...sx(styles.caption)}>
									<p {...sx(styles.index)}>Clip {pad(i + 1)}</p>
									<h3 {...sx(styles.clipTitle)}>{title}</h3>
									<span {...sx(styles.more)}>Play</span>
								</div>
							</div>
						</a>
					))
				}

				{
					press.length > 0 && (
						<div data-hour="1.9" data-landfall="press" {...sx(styles.panel, styles.headPanel)}>
							<div {...sx(styles.above)}>
								<h2 {...sx(styles.heading)}>Press</h2>
							</div>
							<div {...sx(styles.below)}>
								<p {...sx(styles.eyebrow)}>What they wrote</p>
							</div>
						</div>
					)
				}
				{
					press.map(({ headline, quote, url, outlet, dateLabel }) => (
						<a href={url} target="_blank" rel="noopener" data-hour="2.1" {...sx(linkMarker, styles.panel, styles.pressPanel, styles.link)}>
							<div {...sx(styles.above)}>
								<h3 {...sx(styles.headline)}>{quote ? `“${quote}”` : headline}</h3>
							</div>
							<div {...sx(styles.below)}>
								<p {...sx(styles.outlet)}>{outlet}</p>
								{dateLabel && <p {...sx(styles.index)}>{dateLabel}</p>}
								<span {...sx(styles.more)}>Read the piece</span>
							</div>
						</a>
					))
				}

				<div data-hour="3" data-mile={BUOYS.economic.mile} {...sx(styles.panel, styles.buoyPanel)}>
					<div {...sx(styles.above, styles.onDark)}>
						<p {...sx(styles.numeral)}>{BUOYS.economic.mile}</p>
						<p {...sx(styles.unit)}>Nautical miles</p>
						<svg viewBox="0 0 28 64" aria-hidden="true" {...sx(styles.buoy)}><use href="#passage-buoy" /></svg>
					</div>
					<div {...sx(styles.below)}>
						<p {...sx(styles.eyebrow)}>{BUOYS.economic.zone}</p>
						<p {...sx(styles.copy)}>{BUOYS.economic.line}</p>
					</div>
				</div>

				<div data-hour="4" data-landfall="newsletter" {...sx(styles.panel, styles.wide)}>
					<div {...sx(styles.above, styles.onDark)}>
						<div data-approach {...sx(styles.lampWrap, styles.approach)}>
							<svg viewBox="0 0 480 120" role="img" aria-label="A settlement at sea, lit at night" {...sx(styles.skyline, styles.silhouette)}>
								<g fill="currentColor">
									<path d="M20 108h118v12H20zM150 108h196v12H150zM358 108h104v12H358z" />
									<path d="M36 84h30v24H36zM72 72h22v36H72zM100 90h28v18h-28zM164 78h34v30h-34zM204 60h24v48h-24zM236 86h22v22h-22zM262 30h16v78h-16zM284 70h28v38h-28zM318 88h20v20h-20zM372 80h32v28h-32zM410 92h40v16h-40z" />
									<path d="M269 6h2v24h-2zM52 40h2v44h-2zM430 46h2v46h-2z" />
									<path d="M53 40l-16-9 1-2zM53 40l17-6 1 2zM53 40l-1 19h2zM431 46l-15-10 1-2zM431 46l18-4v2zM431 46l-3 19 2 1z" />
									<path d="M138 112h12v2h-12zM346 112h12v2h-12z" />
								</g>
								<g fill="var(--lamp)">
									<path d="M42 90h4v5h-4zM54 98h4v5h-4zM77 78h4v5h-4zM85 92h4v5h-4zM108 96h4v5h-4zM170 84h4v5h-4zM184 96h4v5h-4zM209 66h4v5h-4zM217 80h4v5h-4zM209 94h4v5h-4zM242 92h4v5h-4zM266 40h3v5h-3zM271 56h3v5h-3zM266 74h3v5h-3zM271 92h3v5h-3zM290 76h4v5h-4zM302 90h4v5h-4zM323 94h4v5h-4zM378 86h4v5h-4zM392 96h4v5h-4zM418 98h4v5h-4zM436 98h4v5h-4z" />
									<circle cx="270" cy="6" r="2.5" />
								</g>
							</svg>
							<span {...sx(styles.glow)}></span>
						</div>
					</div>
					<div {...sx(styles.below)}>
						<div aria-hidden="true" {...sx(styles.lampPath)}><span {...sx(styles.lampPathLight)}></span></div>
						<h2 {...sx(styles.clipTitle, styles.landing)}>Word from the water</h2>
						<p {...sx(styles.eyebrow)}>Join the newsletter</p>
						<form {...newsletterForm()} {...sx(styles.form)}>
							<div {...sx(styles.field)}>
								<label for="passage-email" {...sx(styles.srOnly)}>Email address</label>
								<input id="passage-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required {...sx(styles.input)} />
								<button type="submit" aria-label="Subscribe" {...sx(styles.submit)}>
									<svg viewBox="0 0 16 16" aria-hidden="true" {...sx(styles.arrow)}>
										<path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
									</svg>
								</button>
							</div>
							<p data-newsletter-status aria-live="polite" {...sx(styles.status)}></p>
						</form>
					</div>
				</div>
			</div>
		</div>

		<div aria-hidden="true" {...sx(styles.crest)}>
			<svg {...sx(styles.svg)}>
				<pattern id="passage-crest" data-drift={CREST.drift} data-period={CREST.period} width={CREST.period} height="100%" patternUnits="userSpaceOnUse">
					<path d={`${scallop(CREST.period, CREST.height)} V400 H0 Z`} fill="currentColor" />
				</pattern>
				<rect width="100%" height="100%" fill="url(#passage-crest)" />
			</svg>
		</div>

		<nav aria-label="Main" {...sx(styles.nav)}>
			<a href="#top" data-goto="top" {...sx(styles.wordmark)}>{site.title}</a>
			<ul {...sx(styles.navList)}>
				{NAV.map(({ label, to }) => <li><a href={`#${to}`} data-goto={to} {...sx(styles.navLink)}>{label}</a></li>)}
			</ul>
		</nav>

		<div aria-hidden="true" {...sx(styles.log)}>
			<p {...sx(styles.logRow)}>
				<span>Log <span data-log-miles>000.0</span> nm</span>
				<span data-log-zone {...sx(styles.logZone)}>Territorial sea</span>
			</p>
			<div data-log-rule data-tick-class={sx(styles.tick).class} {...sx(styles.rule)}><span {...sx(styles.dot)}></span></div>
		</div>

		<svg width="0" height="0" aria-hidden="true">
			<symbol id="passage-buoy" viewBox="0 0 28 64">
				<circle cx="14" cy="5" r="3.5" fill="var(--lamp)" />
				<path d="M13 8h2v10h-2zM9 18h10l3 30H6z" fill="currentColor" />
				<path d="M8.2 28h11.6l.6 6H7.6z" fill="var(--rust)" />
				<path d="M2 48h24l-3 16H5z" fill="currentColor" />
			</symbol>
		</svg>
	</div>
</section>

<script>
	import "@/lib/newsletter.client";
	import "./passage.client";
</script>
