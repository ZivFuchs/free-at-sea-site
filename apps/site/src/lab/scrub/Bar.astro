---
import { styles as header } from "@/components/header/Header.styles";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { styles } from "./Approach.styles";

/* The site header's look over the pinned shot: clear until the shot releases, wordmark in once the title has gone. */
const site = await getSite();
const links = [
	{ label: "Clips", href: "#clips" },
	{ label: "Press", href: "#press" },
	{ label: "Newsletter", href: "#newsletter" },
];
---

<header data-approach-header {...sx(header.header, header.overlay)} style="--solid: 0; --mark: 0;">
	<nav aria-label="Main" {...sx(layout.container, header.bar, styles.bar)}>
		<a href="#main" {...sx(header.wordmark)}>
			<span {...sx(header.markText)}>{site.title}</span>
		</a>
		<ul {...sx(header.right, styles.nav)}>
			{links.map(({ label, href }) => <li><a href={href} {...sx(header.link)}>{label}</a></li>)}
		</ul>
	</nav>
</header>
