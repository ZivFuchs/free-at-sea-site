---
import { linkMarker, styles } from "@/lab/LabIndex.styles";
import LabLayout from "@/lab/LabLayout.astro";
import { LAB } from "@/lab/registry";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const pad = (n: number) => String(n).padStart(2, "0");
---

<LabLayout>
	<main {...sx(layout.container, styles.page)}>
		<p {...sx(styles.eyebrow)}>Free at Sea · Lab</p>
		<h1 {...sx(styles.title)}>Experiments</h1>
		<p {...sx(styles.lede)}>Each one pushes a single idea as far as it goes. Nothing here is linked from the site.</p>
		<ul {...sx(styles.list)}>
			{
				LAB.map(({ slug, title, pitch, moods, tech }, i) => (
					<li>
						<a href={`/lab/${slug}`} {...sx(linkMarker, styles.link)}>
							<span {...sx(styles.number)}>{pad(i + 1)}</span>
							<span>
								<span {...sx(styles.name)}>{title}</span>
								<p {...sx(styles.pitch)}>{pitch}</p>
								<p {...sx(styles.tags)}>{[...moods, ...tech].join(" · ")}</p>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</LabLayout>
