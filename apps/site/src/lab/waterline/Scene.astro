---
import type { Clip } from "@/lib/clips";
import type { PressItem } from "@/lib/press";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import { attrs } from "./attrs";
import Bar from "./Bar.astro";
import Deep from "./Deep.astro";
import { REST } from "./engine";
import { scene } from "./palette.stylex";
import Surface from "./Surface.astro";
import { styles, submerged } from "./Waterline.styles";

/* The page twice over: in air, and (inert) under water, split by a simulated surface that rises with scroll. */
interface Props {
	site: SiteSettings;
	clips: Clip[];
	press: PressItem[];
}

const content = Astro.props;
---

<div data-waterline {...attrs(scene, styles.scene)} style={{ "--rest": REST }}>
	<main data-air {...sx(styles.layer, styles.air)}>
		<div aria-hidden="true" {...sx(styles.sky)}></div>
		<Bar site={content.site} />
		<Surface {...content} />
	</main>

	<div data-sea {...attrs(submerged, styles.layer, styles.sea)}>
		<div aria-hidden="true" {...sx(styles.body)}><canvas {...sx(styles.canvas)}></canvas></div>
		<div data-copy aria-hidden="true" inert {...sx(styles.copy)}>
			<Surface {...content} twin />
		</div>
		<Deep site={content.site} />
		<Bar site={content.site} twin />
	</div>

	<svg data-surface aria-hidden="true" {...sx(styles.surface)}>
		<path {...sx(styles.shadeWide)}></path>
		<path {...sx(styles.shade)}></path>
		<path {...sx(styles.halo)}></path>
		<path {...sx(styles.glint)}></path>
	</svg>

	<svg aria-hidden="true" {...sx(styles.defs)}>
		<filter id="waterline-wobble" x="-5%" y="-20%" width="110%" height="140%">
			<feTurbulence type="fractalNoise" baseFrequency="0.004 0.012" numOctaves="1" seed="4" result="noise"></feTurbulence>
			<feDisplacementMap in="SourceGraphic" in2="noise" scale="14" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
		</filter>
	</svg>

	<dialog aria-label="Clip player" {...sx(styles.dialog)}>
		<div {...sx(styles.dialogBar)}>
			<p data-title {...sx(styles.dialogTitle)}></p>
			<button type="button" data-close {...sx(styles.close)}>Close</button>
		</div>
		<iframe title="Clip" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen {...sx(styles.player)}></iframe>
	</dialog>
</div>

<script>
	import "@/lib/newsletter.client";
	import { waterline } from "./engine";

	for (const root of document.querySelectorAll<HTMLElement>("[data-waterline]")) {
		waterline(root);

		const dialog = root.querySelector("dialog");
		const player = dialog?.querySelector("iframe");
		const title = dialog?.querySelector<HTMLElement>("[data-title]");
		if (!dialog || !player) continue;
		for (const link of root.querySelectorAll<HTMLAnchorElement>("[data-air] a[data-embed]")) {
			link.addEventListener("click", (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey) return;
				event.preventDefault();
				player.src = link.dataset.embed ?? "";
				if (title) title.textContent = link.dataset.title ?? "";
				dialog.showModal();
			});
		}
		dialog.addEventListener("close", () => player.removeAttribute("src"));
		dialog.addEventListener("click", ({ target }) => {
			if (target === dialog || (target instanceof Element && target.closest("[data-close]"))) dialog.close();
		});
	}
</script>
