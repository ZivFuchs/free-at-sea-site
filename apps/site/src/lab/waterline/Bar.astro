---
import { NAV } from "@/lib/nav";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import { styles } from "./Waterline.styles";

interface Props {
	site: SiteSettings;
	/** The inert underwater duplicate. */
	twin?: boolean;
}

const { site, twin = false } = Astro.props;
---

<header {...sx(styles.bar, twin && styles.barTwin)} aria-hidden={twin ? "true" : undefined} inert={twin}>
	<a href="#top" data-key="mark" {...sx(styles.mark)}>{site.title}</a>
	<nav aria-label="Main" {...sx(styles.nav)}>
		{
			NAV.map(({ label, href }) => (
				<a href={href.replace(/^\//, "")} data-key={`nav-${label}`} {...sx(styles.navLink)}>
					{label}
				</a>
			))
		}
	</nav>
</header>
