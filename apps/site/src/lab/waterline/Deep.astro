---
import { NAV } from "@/lib/nav";
import { newsletterForm } from "@/lib/newsletter";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { styles } from "./Waterline.styles";

/* Below the last of the surface: newsletter, then the footer resting on the seabed. */
interface Props {
	site: SiteSettings;
}

const { site } = Astro.props;
const links = [
	...NAV.map(({ label, href }) => ({ label, href: href.replace(/^\//, "") })),
	...(site.email ? [{ label: "Contact", href: `mailto:${site.email}` }] : []),
];
---

<div data-deep {...sx(styles.deep)}>
	<section id="newsletter" aria-labelledby="waterline-letter" {...sx(layout.container, styles.section, styles.letter)}>
		<h2 id="waterline-letter" {...sx(styles.letterTitle)}>Word from the water</h2>
		<p {...sx(styles.letterSub)}>Join the newsletter</p>
		<form {...newsletterForm()} {...sx(styles.form)}>
			<div {...sx(styles.field)}>
				<label for="waterline-email" {...sx(styles.srOnly)}>Email address</label>
				<input id="waterline-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required {...sx(styles.input)} />
				<button type="submit" {...sx(styles.submit)}>Subscribe</button>
			</div>
			<p data-newsletter-status aria-live="polite" {...sx(styles.status)}></p>
		</form>
	</section>

	<footer {...sx(styles.bed)}>
		<svg viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true" {...sx(styles.dunes)}>
			<defs>
				<linearGradient id="waterline-dune" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="currentColor" {...sx(styles.duneFar)}></stop>
					<stop offset="0.55" stop-color="currentColor" {...sx(styles.duneNear)}></stop>
				</linearGradient>
			</defs>
			<path d="M0 96C200 60 340 56 540 84s330 52 520 28 270-40 380-26V320H0Z" fill="url(#waterline-dune)" opacity="0.6"></path>
			<path d="M0 168c170-26 310-22 480 2s330 36 540 10 290-32 420-14V320H0Z" fill="url(#waterline-dune)"></path>
		</svg>
		<div {...sx(layout.container, styles.footer)}>
			<a href="#top" {...sx(styles.footMark)}>{site.title}</a>
			<nav aria-label="Footer" {...sx(styles.footNav)}>
				{links.map(({ label, href }) => <a href={href} {...sx(styles.footLink)}>{label}</a>)}
			</nav>
			<p {...sx(styles.legal)}>© {new Date().getFullYear()} {site.title}</p>
		</div>
	</footer>
</div>
