---
import { getImage } from "astro:assets";
import still from "@/assets/hero/barge-from-afar.jpg";
import type { Clip } from "@/lib/clips";
import type { Home } from "@/lib/home";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import { styles } from "./Sail.styles";

/* The film projected on a sail. A tall track pins the stage; scroll eases the sheet, brings the camera
 * round to face the cloth, and puts each clip's still on it in turn. */
interface Props {
	site: SiteSettings;
	home: Home;
	clips: Clip[];
}

const { site, home, clips } = Astro.props;
const frame = await getImage({ src: still, width: 1600 });
const pad = (n: number) => String(n).padStart(2, "0");
---

<section
	aria-label="Intro and clips"
	data-sail
	data-still={frame.src}
	data-video={home.heroVideo ?? ""}
	data-posters={JSON.stringify(clips.map((clip) => clip.thumbnail))}
	{...sx(styles.track)}
	style={{ "--clips": clips.length }}
>
	<span id="clips" {...sx(styles.anchor)}></span>
	<div data-stage {...sx(styles.stage)}>
		<canvas aria-hidden="true" {...sx(styles.canvas)}></canvas>
		<div aria-hidden="true" {...sx(styles.shade)}></div>

		<div data-scene data-active {...sx(styles.scene)}>
			<p {...sx(styles.eyebrow)}>Now showing · open sea</p>
			<h1 {...sx(styles.title)}>{site.title}</h1>
			<p {...sx(styles.tagline)}>{site.tagline}</p>
			<p {...sx(styles.hint)}>Scroll to ease the sheet</p>
		</div>

		{
			clips.map(({ title, caption, embed }, i) => (
				<article data-scene {...sx(styles.scene)}>
					<p {...sx(styles.eyebrow)}>
						Reel {pad(i + 1)} / {pad(clips.length)}
					</p>
					<h2 {...sx(styles.clipTitle)}>{title}</h2>
					{caption && <p {...sx(styles.caption)}>{caption}</p>}
					<button type="button" data-play={embed} data-title={title} {...sx(styles.play)}>
						<svg viewBox="0 0 12 14" aria-hidden="true" {...sx(styles.triangle)}>
							<path d="M0 0v14l12-7z" fill="currentColor" />
						</svg>
						Play clip
					</button>
				</article>
			))
		}
	</div>

	<dialog aria-label="Clip player" {...sx(styles.dialog)}>
		<div {...sx(styles.room)}>
			<div {...sx(styles.bar)}>
				<p data-now {...sx(styles.kicker)}></p>
				<button type="button" data-close {...sx(styles.close)}>Close</button>
			</div>
			<div data-frame {...sx(styles.frame)}></div>
		</div>
	</dialog>
</section>

<script>
	import { clamp, onFrame, reducedMotion } from "@/lab/lib/motion";
	import { styles } from "@/lab/sail/Sail.styles";
	import { sx } from "@/lib/sx";

	const track = document.querySelector<HTMLElement>("[data-sail]");
	const stage = track?.querySelector<HTMLElement>("[data-stage]");
	const canvas = stage?.querySelector("canvas");
	const dialog = track?.querySelector("dialog");
	const frame = dialog?.querySelector<HTMLElement>("[data-frame]");

	if (track && stage && canvas) {
		const scenes = [...stage.querySelectorAll<HTMLElement>("[data-scene]")];
		const last = scenes.length - 1;
		const still = reducedMotion();
		const travel = () => Math.max(track.offsetHeight - innerHeight, 1);
		const progress = () => clamp(-track.getBoundingClientRect().top / travel());
		let shown = 0;

		const sync = () => {
			const next = Math.round(progress() * last);
			if (next === shown) return;
			shown = next;
			scenes.forEach((el, i) => el.toggleAttribute("data-active", i === next));
		};
		addEventListener("scroll", sync, { passive: true });
		sync();

		// Tabbing to a clip that is off the sail travels to it.
		scenes.forEach((el, i) =>
			el.addEventListener("focusin", () => {
				if (i !== shown) scrollTo({ top: track.offsetTop + (travel() * i) / Math.max(last, 1) });
			}),
		);

		import("@/lab/sail/scene").then(({ createSail }) => {
			const { still: image = "", video, posters = "[]" } = track.dataset;
			const sail = createSail(
				canvas,
				{ still: image, video: video || null, posters: JSON.parse(posters) as (string | null)[] },
				still,
			);
			if (!sail) return;

			sail.resize();
			const loop = onFrame(stage, (_, dt) => {
				sail.setProgress(progress(), shown);
				sail.frame(dt);
				canvas.setAttribute("data-ready", "");
			});
			new ResizeObserver(() => {
				sail.resize();
				loop.redraw();
			}).observe(canvas);
			addEventListener("scroll", loop.redraw, { passive: true });
			// Stills arrive after the first frame.
			if (still) for (const ms of [400, 1500, 4000]) setTimeout(loop.redraw, ms);

			let at: { x: number; y: number; t: number } | null = null;
			stage.addEventListener(
				"pointermove",
				(e) => {
					const r = stage.getBoundingClientRect();
					const now = { x: e.clientX, y: e.clientY, t: e.timeStamp };
					const speed = at
						? Math.hypot(now.x - at.x, now.y - at.y) / Math.max(now.t - at.t, 1) / 1.5
						: 0;
					at = now;
					sail.pointer(((now.x - r.left) / r.width) * 2 - 1, 1 - ((now.y - r.top) / r.height) * 2, speed);
				},
				{ passive: true },
			);
			stage.addEventListener("pointerleave", () => (at = null));

			addEventListener("pagehide", () => {
				loop.stop();
				sail.dispose();
			});
		});
	}

	if (track && dialog && frame) {
		const now = dialog.querySelector<HTMLElement>("[data-now]");
		for (const button of track.querySelectorAll<HTMLButtonElement>("[data-play]")) {
			button.addEventListener("click", () => {
				const { play = "", title = "" } = button.dataset;
				const src = new URL(play);
				src.searchParams.set("autoplay", "1");
				const player = document.createElement("iframe");
				player.src = src.href;
				player.title = title;
				player.allow = "autoplay; fullscreen; picture-in-picture";
				player.className = sx(styles.player).class ?? "";
				frame.replaceChildren(player);
				if (now) now.textContent = title;
				dialog.showModal();
			});
		}
		dialog.addEventListener("close", () => frame.replaceChildren());
		dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
	}
</script>
