---
import { sx } from "@/lib/sx";
import { styles } from "./SeaLegs.styles";

/* Section break: a full-width rule kept level by script, and a numeral hanging plumb from its centre. */
interface Props {
	label: string;
	/** Line length in rem: sets the swing period. */
	line?: number;
}

const { label, line = 1.25 } = Astro.props;
---

<div aria-hidden="true" {...sx(styles.station)}>
	<span data-level {...sx(styles.rule)}></span>
	<span data-hang={line} {...sx(styles.hang)} style={{ "--line": `${line}rem` }}>
		<span {...sx(styles.line)}></span>
		<span {...sx(styles.tag)}>{label}</span>
	</span>
</div>
