---
import { sx } from "@/lib/sx";
import { styles } from "./Section.styles";
import type { SECTIONS } from "./sections";

/* Wraps one homepage section so the rail, readouts, reveals and lamp can address it. */
type Props = (typeof SECTIONS)[number] & {
	/** Enters with the chosen reveal. Not for the hero, which is on screen at load. */
	reveal?: boolean;
	/** Dark ground: the dive lamp shows here. */
	dark?: boolean;
};

const { id, label, reveal = false, dark = false } = Astro.props;
---

<div
	id={id}
	data-section={label}
	data-reveal-target={reveal ? "" : undefined}
	data-lamp={dark ? "" : undefined}
	{...sx(styles.section, reveal && styles.reveal)}
>
	<slot />
</div>
