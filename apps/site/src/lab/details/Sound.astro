---
import { sx } from "@/lib/sx";
import { styles, switchMarker } from "./Sound.styles";

/* A small switch for a synthesised seascape. Silent until pressed. */
const BEATS = [1.1, 0.8, 1.3, 0.9];
---

<span data-experiment="sound" data-variant="off" data-active hidden></span>
<button type="button" aria-pressed="false" data-experiment="sound" data-variant="ambient" hidden {...sx(switchMarker, styles.toggle)}>
	<span aria-hidden="true" {...sx(styles.bars)}>
		{BEATS.map((s) => <span {...sx(styles.bar)} style={{ "--beat": `${s}s` }}></span>)}
	</span>
	Sound
</button>

<script>
	import { currentSection, onScroll, sectionEls } from "./scroll";
	import { startSea } from "./sea";
	import { variant } from "./variant";

	variant<HTMLButtonElement>("sound", "ambient", {
		on: (button) => {
			const els = sectionEls();
			let sea: ReturnType<typeof startSea> | undefined;
			let unwatch: (() => void) | undefined;

			const silence = () => {
				sea?.stop();
				unwatch?.();
				sea = unwatch = undefined;
				button.setAttribute("aria-pressed", "false");
			};
			const toggle = () => {
				if (sea) return silence();
				const playing = startSea();
				sea = playing;
				button.setAttribute("aria-pressed", "true");
				// Each section down the page is a little further under.
				unwatch = onScroll(() => {
					const here = currentSection(els);
					playing.depth(here ? els.indexOf(here) / Math.max(1, els.length - 1) : 0);
				});
			};

			button.addEventListener("click", toggle);
			return () => {
				button.removeEventListener("click", toggle);
				silence();
			};
		},
	});
</script>
