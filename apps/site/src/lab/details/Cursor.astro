---
import { sx } from "@/lib/sx";
import { styles } from "./Cursor.styles";

/* Pointer and touch effects, as fixed layers that never take input. */
---

<span data-experiment="cursor" data-variant="off" data-active hidden></span>
<canvas aria-hidden="true" data-experiment="cursor" data-variant="wake" hidden {...sx(styles.wake)}></canvas>
<div aria-hidden="true" data-experiment="cursor" data-variant="lamp" hidden {...sx(styles.glow)}></div>
<div aria-hidden="true" data-experiment="cursor" data-variant="lamp" hidden {...sx(styles.lift)}></div>

<script>
	import { startLamp } from "./lamp";
	import { variant } from "./variant";
	import { startWake } from "./wake";

	variant<HTMLCanvasElement>("cursor", "wake", { on: startWake });
	variant("cursor", "lamp", { on: startLamp });
</script>
