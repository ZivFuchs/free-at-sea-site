---
import { cardMarker, styles as press } from "@/components/press/Press.styles";
import PressCard from "@/components/press/PressCard.astro";
import type { PressItem } from "@/lib/press";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { styles } from "./PressVariants.styles";

/* Press covers scattered like prints on water: draggable, gliding to rest. A plain grid without scripting. */
interface Props {
	items: PressItem[];
}

const { items } = Astro.props;

const PER_ROW = 5;
/** Deterministic scatter in −1…1, so the pile is the same on every build. */
const jitter = (i: number, salt: number) => {
	const v = Math.sin(i * 127.1 + salt * 311.7) * 43758.5453;
	return (v - Math.floor(v)) * 2 - 1;
};
const cols = Math.min(items.length, PER_ROW);
const rowsDesk = Math.ceil(items.length / PER_ROW) - 1;
const place = (i: number) => {
	const col = i % PER_ROW;
	const row = Math.floor(i / PER_ROW);
	return {
		"--xm": i % 2 === 0 ? 0.04 + 0.1 * (jitter(i, 1) + 1) : 0.96 - 0.1 * (jitter(i, 1) + 1),
		"--ym": i * 12.5 + jitter(i, 2) * 0.75,
		"--xd": cols > 1 ? col / (cols - 1) : 0.5,
		"--yd": row * 15 + 2 + jitter(i, 3) * 2,
		"--r": `${(jitter(i, 4) * 5 + (i % 2 ? 1.5 : -1.5)).toFixed(2)}deg`,
		"--period": `${(6 + jitter(i, 5) * 1.5).toFixed(2)}s`,
		"--delay": `${(-3 + jitter(i, 6) * 3).toFixed(2)}s`,
	};
};
---

<section aria-label="Press" data-experiment="press" data-variant="flotsam" hidden {...sx(press.section)}>
	<div {...sx(layout.container)}>
		<div {...sx(press.head)}><h2 {...sx(press.heading)}>Press</h2></div>
		<ul data-pile {...sx(styles.area)} style={{ "--rows-m": items.length - 1, "--rows-d": rowsDesk, "--cols-d": cols }}>
			{items.map((item, i) => (
				<li data-print {...sx(cardMarker, styles.print)} style={place(i)}>
					<div {...sx(styles.ride)}><PressCard item={item} eager={false} /></div>
				</li>
			))}
		</ul>
		<p aria-hidden="true" {...sx(styles.hint)}>Adrift. Move them about.</p>
	</div>
</section>

<script>
	import { startFlotsam } from "./flotsam";
	import { variant } from "./variant";

	variant("press", "flotsam", {
		on: (section) => {
			const pile = section.querySelector<HTMLElement>("[data-pile]");
			return pile ? startFlotsam(pile) : undefined;
		},
	});
</script>
