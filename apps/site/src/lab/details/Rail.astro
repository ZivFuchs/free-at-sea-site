---
import { sx } from "@/lib/sx";
import { stopMarker, styles } from "./Rail.styles";
import { SECTIONS } from "./sections";

/* A tick per section on the right edge; the current one lengthens and names itself while the page moves. */
---

<span data-experiment="nav" data-variant="off" data-active hidden></span>
<nav aria-label="Sections" data-experiment="nav" data-variant="dots" hidden {...sx(styles.rail)}>
	<ol {...sx(styles.list)}>
		{SECTIONS.map(({ id, label }) => (
			<li>
				<a href={`#${id}`} data-stop={id} {...sx(stopMarker, styles.stop)}>
					<span {...sx(styles.label)}>{label}</span>
					<span aria-hidden="true" {...sx(styles.tick)}></span>
				</a>
			</li>
		))}
	</ol>
</nav>

<script>
	import { currentSection, onScroll, sectionEls } from "./scroll";
	import { variant } from "./variant";

	/** How long the current stop keeps its name after scrolling ends. */
	const LINGER_MS = 1400;

	variant("nav", "dots", {
		on: (rail) => {
			const els = sectionEls();
			const stops = [...rail.querySelectorAll<HTMLAnchorElement>("[data-stop]")];
			let timer = 0;
			let first = true;

			const stop = onScroll(() => {
				const here = currentSection(els);
				for (const el of stops) {
					const on = el.dataset.stop === here?.id;
					if (on) el.setAttribute("aria-current", "location");
					else el.removeAttribute("aria-current");
					el.toggleAttribute("data-show", on && !first);
				}
				first = false;
				clearTimeout(timer);
				timer = window.setTimeout(() => {
					for (const el of stops) el.removeAttribute("data-show");
				}, LINGER_MS);
			});
			return () => {
				stop();
				clearTimeout(timer);
			};
		},
	});
</script>
