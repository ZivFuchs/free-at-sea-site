---
import { cardMarker, styles as press } from "@/components/press/Press.styles";
import PressCard from "@/components/press/PressCard.astro";
import type { PressItem } from "@/lib/press";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { styles } from "./PressVariants.styles";

/* The press rack, afloat: each cover bobs on its own phase and answers a press or a fling. */
interface Props {
	items: PressItem[];
}

const { items } = Astro.props;
---

<section aria-label="Press" data-experiment="press" data-variant="buoyant" hidden {...sx(press.section)}>
	<div {...sx(layout.container)}>
		<div {...sx(press.head)}><h2 {...sx(press.heading)}>Press</h2></div>
		<ul data-buoy {...sx(press.track, styles.trackRoom)}>
			{items.map((item, i) => (
				<li {...sx(cardMarker, press.card)}>
					<div data-float {...sx(styles.float)}>
						<PressCard item={item} eager={i < 2} />
						<span aria-hidden="true" {...sx(styles.sheen)}><span {...sx(styles.sheenBand)}></span></span>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<script>
	import { startBuoy } from "./buoy";
	import { variant } from "./variant";

	variant("press", "buoyant", {
		on: (section) => {
			const track = section.querySelector<HTMLElement>("[data-buoy]");
			return track ? startBuoy(track) : undefined;
		},
	});
</script>
