---
import { sx } from "@/lib/sx";
import { seamMarker, styles } from "./Divider.styles";

/* The seam between two sections, in each `dividers` variant. Takes no layout room. */
interface Props {
	/** Which neighbour the swell overlays: the section above (default) or below. */
	over?: "above" | "below";
	/** Both neighbours share the page ground: draw a lit swell line instead of a cut. */
	ghost?: boolean;
}

const { over = "above", ghost = false } = Astro.props;
---

<div aria-hidden="true" data-experiment="dividers" data-variant="swell" hidden {...sx(styles.seam)}>
	<div {...sx(styles.band, over === "above" ? styles.above : styles.below)}>
		<div {...sx(styles.lag)}><div {...sx(ghost ? styles.ghostFar : styles.far)}></div></div>
		<div {...sx(ghost ? styles.ghostNear : styles.near)}></div>
		<div {...sx(styles.crest)}></div>
	</div>
</div>
<div aria-hidden="true" data-experiment="dividers" data-variant="foam" data-foam hidden {...sx(seamMarker, styles.seam)}>
	<div {...sx(styles.foam)}>
		<div {...sx(styles.wash)}><div {...sx(styles.lace)}></div></div>
	</div>
</div>
