---
/* Markers for the `reveal` group. `surface` is CSS on each section wrapper, switched by `data-reveal`;
 * `tide-in` masks the section headings from script. */
---

<span data-experiment="reveal" data-variant="off" data-active hidden></span>
<span data-experiment="reveal" data-variant="surface" hidden></span>
<span data-experiment="reveal" data-variant="tide-in" hidden></span>

<script>
	import { startTideIn } from "./tideIn";
	import { variant } from "./variant";

	const targets = [...document.querySelectorAll<HTMLElement>("[data-reveal-target]")];

	variant("reveal", "surface", {
		on: () => {
			for (const el of targets) el.dataset.reveal = "surface";
			return () => {
				for (const el of targets) delete el.dataset.reveal;
			};
		},
	});
	variant("reveal", "tide-in", {
		on: () => startTideIn(targets.flatMap((el) => [...el.querySelectorAll<HTMLElement>("h2")])),
	});
</script>
