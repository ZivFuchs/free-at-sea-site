---
import { styles as header } from "@/components/header/Header.styles";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { NAV } from "./sections";

/* The site's full-screen phone menu, pointed at this page's sections. */
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<nav id={id} popover aria-label="Main" data-details-menu {...sx(header.menu)}>
	<div {...sx(layout.container, header.bar)}>
		<a href="#d-surface" {...sx(header.wordmark)}>{title}</a>
		<button type="button" popovertarget={id} popovertargetaction="hide" aria-label="Close menu" {...sx(header.toggle, header.close)}>
			<span {...sx(header.line, header.cross)}></span>
			<span {...sx(header.line, header.cross, header.crossAlt)}></span>
		</button>
	</div>
	<ul {...sx(layout.container, header.menuList)}>
		{NAV.map(({ id: target, label }) => <li><a href={`#${target}`} {...sx(header.menuLink)}>{label}</a></li>)}
	</ul>
</nav>

<script>
	for (const menu of document.querySelectorAll<HTMLElement>("[data-details-menu]")) {
		menu.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) menu.hidePopover();
		});
	}
</script>
