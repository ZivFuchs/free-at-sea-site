---
import type { Home } from "@/lib/home";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import Media from "./Media.astro";
import { styles } from "./Sinking.styles";
import { HORIZON } from "./shared";

/* The title stands on the horizon and goes under as you scroll: crisp above the waterline, a rippling,
 * foreshortened ghost below it. */
interface Props {
	site: SiteSettings;
	home: Home;
}

const { site, home } = Astro.props;
/** Lower than the footage's own horizon, so the title has sky to stand in; the sky is mirrored up to fit. */
const WATER = 0.34;
const STRIPS = 32;
---

<section aria-label="Intro" data-sinking {...sx(styles.section)} style={{ "--horizon": HORIZON, "--water": WATER }}>
	<div {...sx(styles.stage)}>
		<div aria-hidden="true" {...sx(styles.sky)}><Media home={home} video={false} decorative /></div>
		<div {...sx(styles.photo)}><Media home={home} video={false} /></div>

		<div {...sx(styles.type, styles.above)}>
			<h1 {...sx(styles.title, styles.dry)}>{site.title}</h1>
		</div>
		<div aria-hidden="true" {...sx(styles.type, styles.below)}>
			{
				Array.from({ length: STRIPS }, (_, i) => (
					<div {...sx(styles.strip)} style={{ "--i": i, "--sway": `${0.004 + i * 0.0011}em` }}>
						<p {...sx(styles.title, styles.wet, styles.slice)}>{site.title}</p>
					</div>
				))
			}
		</div>
		<div aria-hidden="true" {...sx(styles.glint)}></div>
		<p data-hero-fade {...sx(styles.tagline)}>{site.tagline}</p>

	</div>
	<div data-anchor {...sx(styles.anchor)}></div>
</section>

<script>
	import { onScrollThrough, onVariant } from "./lifecycle";

	/** Ems the title travels: its own height and a little more, by which depth it has faded out. */
	const DEPTH = 1.25;

	onVariant("sinking", (root) => {
		const section = root.querySelector<HTMLElement>("[data-sinking]");
		if (!section) return;
		return onScrollThrough(section, 0.72, (p) => {
			section.style.setProperty("--sink", String(p * DEPTH));
			section.style.setProperty("--glint", String(Math.sin(Math.min(p * 1.25, 1) * Math.PI) * 0.7));
		});
	});
</script>
