---
import { Image } from "astro:assets";
import still from "@/assets/hero/barge-from-afar.jpg";
import type { Home } from "@/lib/home";
import { sx } from "@/lib/sx";
import { hero } from "./Hero.styles";
import { HORIZON } from "./shared";

/* The hero footage, filling its positioned parent. The video loads only when its variant is shown (`playVideos`). */
interface Props {
	home: Home;
	video?: boolean;
	decorative?: boolean;
}

const { home, video = true, decorative = false } = Astro.props;
const position = `50% ${HORIZON * 100}%`;
const alt = decorative ? "" : "The barge alone on open sea, seen from far above";
---

{
	home.heroPoster ? (
		<img
			src={home.heroPoster.src}
			srcset={home.heroPoster.srcset}
			sizes="100vw"
			alt={alt}
			loading="lazy"
			decoding="async"
			{...sx(hero.fill, hero.cover)}
			style={{ objectPosition: position }}
		/>
	) : (
		<Image
			src={still}
			alt={alt}
			widths={[768, 1280, 1920, 2880]}
			sizes="100vw"
			loading="lazy"
			{...sx(hero.fill, hero.cover)}
			style={{ objectPosition: position }}
		/>
	)
}
{
	video && home.heroVideo && (
		<video
			data-src={home.heroVideo}
			muted
			loop
			playsinline
			preload="none"
			aria-hidden="true"
			{...sx(hero.fill, hero.cover, hero.video)}
			style={{ objectPosition: position }}
		/>
	)
}
