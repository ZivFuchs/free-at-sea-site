---
import Experiment from "@/components/experiments/Experiment.astro";
import Waterline from "@/components/hero/Waterline.astro";
import type { Home } from "@/lib/home";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import Depth from "./Depth.astro";
import FirstLight from "./FirstLight.astro";
import Forecast from "./Forecast.astro";
import { styles } from "./HeroShowcase.styles";
import Letters from "./Letters.astro";
import Sinking from "./Sinking.astro";
import { HERO_KEY } from "./shared";
import type { HeroVariantId } from "./variants";

interface Props {
	site: SiteSettings;
	home: Home;
}

const { site, home } = Astro.props;
const ACTIVE: HeroVariantId = "current";
const variant = (id: HeroVariantId) => ({ group: HERO_KEY, id, active: id === ACTIVE });
---

<div data-heroes {...sx(styles.showcase)}>
	<div data-hero-title aria-hidden="true" {...sx(styles.proxy)}></div>
	<Experiment {...variant("current")}><Waterline site={site} home={home} /></Experiment>
	<Experiment {...variant("letters")}><Letters site={site} home={home} /></Experiment>
	<Experiment {...variant("depth")}><Depth site={site} /></Experiment>
	<Experiment {...variant("sinking")}><Sinking site={site} home={home} /></Experiment>
	<Experiment {...variant("forecast")}><Forecast site={site} home={home} /></Experiment>
	<Experiment {...variant("first-light")}><FirstLight site={site} /></Experiment>
</div>

<script>
	import { HERO_KEY, SYNC_EVENT } from "./shared";

	/* The site header reads one `[data-hero-title]` at load to time its wordmark crossfade, and takes its
	 * top text tone from the homepage footage. Keep both true for whichever variant is showing. */
	const showcase = document.querySelector<HTMLElement>("[data-heroes]");
	const proxy = showcase?.querySelector<HTMLElement>(":scope > [data-hero-title]");
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const TOP = "--top";
	const tones = { ink: "var(--app-ink)", paper: "var(--app-paper)", own: header?.style.getPropertyValue(TOP) ?? "" };

	if (showcase && proxy) {
		const variants = [...showcase.querySelectorAll<HTMLElement>(`[data-experiment="${HERO_KEY}"]`)];
		let frame = 0;

		const sync = () => {
			frame = 0;
			const active = variants.find((v) => !v.hidden);
			const anchor = active?.querySelector<HTMLElement>("[data-anchor], [data-hero-title]");
			if (!active || !anchor) return;
			const from = showcase.getBoundingClientRect();
			const at = anchor.getBoundingClientRect();
			proxy.style.top = `${at.top - from.top}px`;
			proxy.style.left = `${at.left - from.left}px`;
			proxy.style.width = `${at.width}px`;
			proxy.style.height = `${at.height}px`;

			const top = active.querySelector<HTMLElement>("[data-top]")?.dataset.top;
			const tone = top === "ink" || top === "paper" ? tones[top] : tones.own;
			if (tone) header?.style.setProperty(TOP, tone);
			else header?.style.removeProperty(TOP);
			// The header re-measures on scroll.
			dispatchEvent(new Event("scroll"));
		};
		const queue = () => {
			frame ||= requestAnimationFrame(sync);
		};

		for (const variant of variants) variant.addEventListener(`${HERO_KEY}:activate`, queue);
		showcase.addEventListener(SYNC_EVENT, queue);
		addEventListener("resize", queue);
		document.fonts.ready.then(queue);
		queue();
	}
</script>
