---
import type { StyleXStyles } from "@stylexjs/stylex";
import { sx } from "@/lib/sx";
import { styles } from "./Ink.styles";
import type { Wash } from "./washes";

/* One sheet of washes, painted by `wash.ts` when it scrolls into view. Decoration only. */
interface Props {
	washes: readonly Wash[];
	/** Photograph for a `photo` wash; must allow CORS, else the fallback image shows. */
	photo?: string | null;
	place?: StyleXStyles;
}

const { washes, photo, place } = Astro.props;
---

<canvas data-wash={JSON.stringify(washes)} data-photo={photo ?? undefined} aria-hidden="true" {...sx(styles.sheet, place)}></canvas>
