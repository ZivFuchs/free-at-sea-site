---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Poster } from "@/lib/home";
import { sx } from "@/lib/sx";
import { styles } from "./HeroMedia.styles";

/* Full-bleed backdrop. `poster` (the loop's first frame) shows until `video` (a muted loop) fades in over it;
 * without a poster, `image` drifts slowly instead. `horizon` (0–1) pins the horizon to the same fraction of the frame at any aspect ratio. */

interface Props {
	image: ImageMetadata;
	alt: string;
	video?: string | null;
	poster?: Poster | null;
	horizon?: number;
}

const { image, alt, video, poster, horizon = 0.5 } = Astro.props;
const position = `50% ${horizon * 100}%`;
---

<div {...sx(styles.frame)} style={{ "--horizon": horizon }}>
	{
		poster ? (
			<img
				src={poster.src}
				srcset={poster.srcset}
				sizes="100vw"
				alt={alt}
				loading="eager"
				fetchpriority="high"
				{...sx(styles.media, styles.reveal)}
				style={{ objectPosition: position }}
			/>
		) : (
			<Image
				src={image}
				alt={alt}
				widths={[768, 1280, 1920, 2880]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
				{...sx(styles.media, styles.reveal, styles.drift)}
				style={{ objectPosition: position }}
			/>
		)
	}
	{
		video && (
			<video
				data-hero-video
				data-src={video}
				muted
				loop
				playsinline
				aria-hidden="true"
				{...sx(styles.media, styles.video)}
				style={{ objectPosition: position }}
			/>
		)
	}
</div>

<script>
	for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-hero-video]")) {
		video.addEventListener("playing", () => video.setAttribute("data-playing", ""), { once: true });
		video.src = video.dataset.src ?? "";
		video.play().catch(() => {});
	}
</script>
