---
import { Font } from "astro:assets";
import still from "@/assets/hero/barge-from-afar.jpg";
import Experiment from "@/components/experiments/Experiment.astro";
import type { Home } from "@/lib/home";
import type { SiteSettings } from "@/lib/site";
import { sx } from "@/lib/sx";
import { HERO_FONTS } from "./fonts";
import HeroMedia from "./HeroMedia.astro";
import { heroMarker, styles } from "./Waterline.styles";

interface Props {
	site: SiteSettings;
	home: Home;
}

const { site, home } = Astro.props;
const HORIZON = 0.178;
---

<section
	aria-label="Intro"
	data-hero
	{...sx(heroMarker, styles.section)}
	style={{ "--horizon": HORIZON }}
>
	<HeroMedia
		image={still}
		alt="The barge alone on open sea, seen from far above"
		video={home.heroVideo}
		poster={home.heroPoster}
		horizon={HORIZON}
	/>

	<div {...sx(styles.copy)}>
		{
			HERO_FONTS.map(({ id, cssVariable, size, tracking }, i) => (
				<Experiment group="hero-font" id={id} active={i === 0}>
					<h1
						{...sx(styles.text, styles.title)}
						style={{ fontFamily: `var(${cssVariable})`, letterSpacing: tracking, "--size": size }}
					>
						{site.title}
					</h1>
				</Experiment>
			))
		}
		<p {...sx(styles.text, styles.tagline)}>{site.tagline}</p>
	</div>

	{HERO_FONTS.slice(1).map(({ cssVariable }) => <Font cssVariable={cssVariable} />)}
</section>

<script>
	const READY_TIMEOUT = 2500;
	for (const hero of document.querySelectorAll<HTMLElement>("[data-hero]")) {
		const backdrop = hero.querySelector("img");
		Promise.race([
			Promise.all([document.fonts.ready, backdrop?.decode().catch(() => {})]),
			new Promise((resolve) => setTimeout(resolve, READY_TIMEOUT)),
		]).then(() => hero.setAttribute("data-ready", ""));
	}
</script>
