---
/* Hero directions compared in place. Rendered as the `hero` group of the experiments panel. */
import Experiment from "@/components/experiments/Experiment.astro";
import type { ExperimentGroup } from "@/components/experiments/types";
import type { Home } from "@/lib/home";
import type { SiteSettings } from "@/lib/site";
import Waterline from "./Waterline.astro";

interface Props {
	site: SiteSettings;
	home: Home;
}

const { site, home } = Astro.props;

export const heroExperiment: ExperimentGroup = {
	key: "hero",
	label: "Hero",
	variants: [
		{
			id: "waterline",
			label: "1 · Waterline",
			note: "The title sits on the horizon over the sea loop, slightly translucent.",
		},
	],
};
---

<Experiment group="hero" id="waterline" active>
	<Waterline site={site} home={home} />
</Experiment>
