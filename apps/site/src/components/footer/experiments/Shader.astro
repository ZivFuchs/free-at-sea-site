---
import { sx } from "@/lib/sx";
import { styles } from "./Shader.styles";

/* Full-bleed WebGL fragment shader. `sources` are concatenated in order. `text` is set in the display face into
 * `u_text`. Runs at 30fps only while on screen; draws one still frame under reduced motion. */
interface Props {
	sources: readonly string[];
	/** Fraction of device resolution to render at. Raymarched scenes want less. */
	resolution?: number;
	text?: string;
}

const { sources, resolution = 1, text } = Astro.props;
---

<canvas data-shader={sources.join("\n")} data-resolution={resolution} data-text={text} {...sx(styles.canvas)}></canvas>

<script>
	const VERTEX = "attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}";
	const TEXT = { width: 2048, height: 512 };
	const MAX_DPR = 1.5;
	const FRAME_MS = 1000 / 30;
	const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

	const compile = (gl: WebGLRenderingContext, type: GLenum, source: string) => {
		const shader = gl.createShader(type);
		if (!shader) return null;
		gl.shaderSource(shader, source);
		gl.compileShader(shader);
		if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;
		console.error(gl.getShaderInfoLog(shader));
		return null;
	};

	const link = (gl: WebGLRenderingContext, fragment: string) => {
		const program = gl.createProgram();
		const vs = compile(gl, gl.VERTEX_SHADER, VERTEX);
		const fs = compile(gl, gl.FRAGMENT_SHADER, fragment);
		if (!vs || !fs) return null;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		return gl.getProgramParameter(program, gl.LINK_STATUS) ? program : null;
	};

	const loadText = async (gl: WebGLRenderingContext, text: string) => {
		const family = getComputedStyle(document.documentElement).getPropertyValue("--font-anton");
		await document.fonts.load(`100px ${family}`);
		const canvas = document.createElement("canvas");
		canvas.width = TEXT.width;
		canvas.height = TEXT.height;
		const ctx = canvas.getContext("2d");
		if (!ctx) return;
		ctx.font = `100px ${family}`;
		const m = ctx.measureText(text);
		const size =
			100 *
			Math.min(
				(TEXT.width * 0.94) / m.width,
				(TEXT.height * 0.8) / (m.actualBoundingBoxAscent + m.actualBoundingBoxDescent),
			);
		ctx.font = `${size}px ${family}`;
		ctx.fillStyle = "white";
		ctx.textAlign = "center";
		ctx.fillText(
			text,
			TEXT.width / 2,
			TEXT.height / 2 + ((m.actualBoundingBoxAscent - m.actualBoundingBoxDescent) * size) / 200,
		);

		gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
		gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
		gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, canvas);
		gl.generateMipmap(gl.TEXTURE_2D);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
	};

	const run = (canvas: HTMLCanvasElement) => {
		const { shader = "", resolution = "1", text } = canvas.dataset;
		const gl = canvas.getContext("webgl", { alpha: false, antialias: false, depth: false });
		const program = gl && link(gl, shader);
		if (!gl || !program) return;

		gl.useProgram(program);
		gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		gl.enableVertexAttribArray(0);
		gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
		gl.uniform1f(gl.getUniformLocation(program, "u_textAspect"), TEXT.width / TEXT.height);
		const uRes = gl.getUniformLocation(program, "u_res");
		const uTime = gl.getUniformLocation(program, "u_time");

		let visible = false;
		let frame = 0;
		let last = -Infinity;

		const loop = (ms: number) => {
			frame = 0;
			if (ms - last >= FRAME_MS) {
				last = ms;
				gl.uniform2f(uRes, canvas.width, canvas.height);
				gl.uniform1f(uTime, still ? 20 : ms / 1000);
				gl.drawArrays(gl.TRIANGLES, 0, 3);
			}
			if (visible && !still) frame = requestAnimationFrame(loop);
		};
		const redraw = () => {
			last = -Infinity;
			if (!frame) frame = requestAnimationFrame(loop);
		};

		new ResizeObserver(() => {
			const scale = Math.min(devicePixelRatio, MAX_DPR) * Number(resolution);
			canvas.width = Math.round(canvas.clientWidth * scale);
			canvas.height = Math.round(canvas.clientHeight * scale);
			gl.viewport(0, 0, canvas.width, canvas.height);
			redraw();
		}).observe(canvas);

		new IntersectionObserver(
			([entry]) => {
				visible = entry?.isIntersecting ?? false;
				if (visible) redraw();
			},
			{ rootMargin: "200px" },
		).observe(canvas);

		if (text) loadText(gl, text).then(redraw);
	};

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas[data-shader]")) run(canvas);
</script>
