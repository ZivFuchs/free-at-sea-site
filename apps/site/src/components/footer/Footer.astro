---
import { styles as header } from "@/components/header/Header.styles";
import { NAV } from "@/lib/nav";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { styles } from "./Footer.styles";

/* Mirrors the header: wordmark centred, links either side. */
const site = await getSite();
const links = [...NAV, ...(site.email ? [{ label: "Contact", href: `mailto:${site.email}` }] : [])];
const split = Math.floor(links.length / 2);
const sides = [
	{ items: links.slice(0, split), side: styles.left },
	{ items: links.slice(split), side: styles.right },
];
---

<footer {...sx(styles.footer)}>
	<div {...sx(styles.bar)}>
		<nav aria-label="Footer" {...sx(layout.container, styles.row)}>
			{sides.map(({ items, side }, i) => (
				<Fragment>
					{i === 1 && <a href="/" {...sx(header.wordmark, styles.wordmark)}>{site.title}</a>}
					<ul {...sx(styles.side, side)}>
						{items.map(({ label, href }) => (
							<li><a href={href} {...sx(header.link)}>{label}</a></li>
						))}
					</ul>
				</Fragment>
			))}
		</nav>
		<p {...sx(layout.container, styles.legal)}>© {new Date().getFullYear()} {site.title}</p>
	</div>
</footer>
