---
import { donationView } from "@/lib/donations";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";
import { styles } from "./02-Stepper.styles";
import type { DonateVariantProps } from "./props";

export const variant = {
	id: "stepper",
	label: "Stepper",
	note: "One calm centred column: pick a method tile, then amount and one big button.",
};

type Props = DonateVariantProps;
const { donations } = Astro.props;
const { heading, blurb, note, amounts, custom, wallets, other, sample } = donations;

const { hasOneTime, hasMonthly, hasCard, hasCustom, start, chosen, tabs, cta } =
	donationView(donations);
const first = tabs[0]?.id;
const more = (labels: string[]) =>
	labels.length > 2 ? `${labels.slice(0, 2).join(", ")} +${labels.length - 2}` : labels.join(", ");
const hints: Record<string, string> = {
	card: "Apple Pay, Google Pay",
	crypto: more(wallets.map((w) => w.label)),
	other: more(other.map((o) => o.label)),
};
const step = tabs.length > 1 ? 2 : 1;
---

<section aria-labelledby="donate-stepper-heading" data-donate {...sx(styles.section)}>
	<div {...sx(layout.container, styles.column)}>
		<header {...sx(styles.intro)}>
			<h2 id="donate-stepper-heading" {...sx(styles.heading)}>{heading}</h2>
			{blurb && <p {...sx(styles.blurb)}>{blurb}</p>}
			{sample && <p {...sx(styles.sample)}>Sample content: fill in Studio → Donations.</p>}
		</header>

		{
			tabs.length > 1 && (
				<div {...sx(styles.step)}>
					<p {...sx(styles.stepLabel)}>
						<span {...sx(styles.stepNum)}>1</span>How would you like to give?
					</p>
					<div role="tablist" aria-label="How to give" {...sx(styles.tiles)}>
						{tabs.map(({ id, label }, i) => (
							<button
								type="button"
								role="tab"
								id={`donate-stepper-tab-${id}`}
								aria-controls={`donate-stepper-panel-${id}`}
								aria-selected={i === 0 ? "true" : "false"}
								tabindex={i === 0 ? 0 : -1}
								data-tab={id}
								{...sx(styles.tile)}
							>
								<span {...sx(styles.tileLabel)}>{label}</span>
								<span {...sx(styles.tileHint)}>{hints[id]}</span>
							</button>
						))}
					</div>
				</div>
			)
		}

		<div {...sx(styles.step)}>
			{
				hasCard && (
					<div
						id="donate-stepper-panel-card"
						role="tabpanel"
						aria-labelledby={tabs.length > 1 ? "donate-stepper-tab-card" : undefined}
						data-panel="card"
						{...sx(styles.pane)}
					>
						<p {...sx(styles.stepLabel)}>
							<span {...sx(styles.stepNum)}>{step}</span>Choose an amount
						</p>
						{hasOneTime && hasMonthly && (
							<div role="group" aria-label="Frequency" {...sx(styles.segmented)}>
								<button type="button" data-frequency="oneTime" aria-pressed="true" {...sx(styles.segment)}>
									Once
								</button>
								<button type="button" data-frequency="monthly" aria-pressed="false" {...sx(styles.segment)}>
									Monthly
								</button>
							</div>
						)}
						<div role="group" aria-label="Amount" {...sx(styles.amounts)}>
							{amounts.map((a) => (
								<button
									type="button"
									data-amount={a.label}
									data-one-time={a.oneTime ?? ""}
									data-monthly={a.monthly ?? ""}
									aria-pressed={a === chosen ? "true" : "false"}
									hidden={!a[start]}
									{...sx(styles.chip)}
								>
									{a.label}
								</button>
							))}
							{hasCustom && (
								<button
									type="button"
									data-amount=""
									data-one-time={custom.oneTime ?? ""}
									data-monthly={custom.monthly ?? ""}
									aria-pressed={chosen ? "false" : "true"}
									hidden={!custom[start]}
									{...sx(styles.chip, styles.chipOther)}
								>
									Other
								</button>
							)}
						</div>
						<a href={cta.href} target="_blank" rel="noopener" data-cta {...sx(styles.cta)}>
							<span data-cta-label>{cta.label}</span>
							<span data-cta-suffix hidden={start !== "monthly"}>/ month</span>
							<svg viewBox="0 0 16 16" aria-hidden="true" {...sx(styles.arrow)}>
								<path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</a>
						<p {...sx(styles.fine)}>Secure checkout by Stripe. Cards, Apple Pay and Google Pay.</p>
					</div>
				)
			}

			{
				wallets.length > 0 && (
					<div
						id="donate-stepper-panel-crypto"
						role="tabpanel"
						aria-labelledby={tabs.length > 1 ? "donate-stepper-tab-crypto" : undefined}
						data-panel="crypto"
						hidden={first !== "crypto"}
						{...sx(styles.pane)}
					>
						<p {...sx(styles.stepLabel)}>
							<span {...sx(styles.stepNum)}>{step}</span>Choose a coin
						</p>
						{wallets.length > 1 && (
							<div role="group" aria-label="Currency" {...sx(styles.coins)}>
								{wallets.map((w, i) => (
									<button type="button" data-wallet={i} aria-pressed={i === 0 ? "true" : "false"} {...sx(styles.coin)}>
										{w.label}
									</button>
								))}
							</div>
						)}
						{wallets.map((w, i) => (
							<div data-wallet-pane={i} hidden={i !== 0} {...sx(styles.wallet)}>
								<div aria-hidden="true" set:html={w.qr} {...sx(styles.qr)} />
								<p {...sx(styles.warning)}>
									Send only {w.symbol ?? w.label} on {w.network}
								</p>
								<code {...sx(styles.address)}>{w.address}</code>
								{w.memo && (
									<p {...sx(styles.memo)}>
										Memo / tag: <code>{w.memo}</code>
									</p>
								)}
								<div {...sx(styles.actions)}>
									<button
										type="button"
										data-copy={w.address}
										aria-label={`Copy ${w.label} address`}
										{...sx(styles.action, styles.actionPrimary)}
									>
										<span data-copy-label>Copy address</span>
									</button>
									{w.uri && (
										<a href={w.uri} {...sx(styles.action)}>
											Open in wallet
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				)
			}

			{
				other.length > 0 && (
					<div
						id="donate-stepper-panel-other"
						role="tabpanel"
						aria-labelledby={tabs.length > 1 ? "donate-stepper-tab-other" : undefined}
						data-panel="other"
						hidden={first !== "other"}
						{...sx(styles.pane)}
					>
						<p {...sx(styles.stepLabel)}>
							<span {...sx(styles.stepNum)}>{step}</span>Continue with
						</p>
						<ul {...sx(styles.otherList)}>
							{other.map(({ label, url }) => (
								<li>
									<a href={url} target="_blank" rel="noopener" {...sx(styles.otherLink)}>
										{label}
										<svg viewBox="0 0 16 16" aria-hidden="true" {...sx(styles.arrow)}>
											<path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
										</svg>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>

		{note && <p {...sx(styles.note)}>{note}</p>}
	</div>
</section>

<script>
	import "@/lib/donate.client";
</script>
