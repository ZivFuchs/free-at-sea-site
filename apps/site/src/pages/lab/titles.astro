---
import Clips from "@/components/clips/Clips.astro";
import Footer from "@/components/footer/Footer.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import Press from "@/components/press/Press.astro";
import LabLayout from "@/lab/LabLayout.astro";
import Credits from "@/lab/titles/Credits.astro";
import Hero from "@/lab/titles/Hero.astro";
import { styles } from "@/lab/titles/Titles.styles";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const nav = [
	{ label: "Clips", href: "#clips" },
	{ label: "Press", href: "#press" },
	{ label: "Credits", href: "#credits" },
	{ label: "Newsletter", href: "#newsletter" },
];
---

<LabLayout slug="titles">
	<div data-titles>
		<header data-titles-header {...sx(styles.header)}>
			<nav aria-label="Main" {...sx(layout.container, styles.bar)}>
				<a href="#top" {...sx(styles.wordmark)}>{site.title}</a>
				<ul {...sx(styles.nav)}>
					{nav.map(({ label, href }) => <li><a href={href} {...sx(styles.link, home.heroBackdrop === "light" && styles.linkOnLight)}>{label}</a></li>)}
				</ul>
			</nav>
		</header>
		<main id="top">
			<Hero site={site} home={home} />
			<Clips clips={clips} />
			<Press items={press} />
			<Credits site={site} clips={clips} press={press} />
			<Newsletter home={home} />
		</main>
	</div>
	<Footer />
</LabLayout>

<script>
	import { runTitles } from "@/lab/titles/titles.client";

	for (const root of document.querySelectorAll<HTMLElement>("[data-titles]")) runTitles(root);
</script>
