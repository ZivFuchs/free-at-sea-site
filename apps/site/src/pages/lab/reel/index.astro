---
import Waterline from "@/components/hero/Waterline.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import { getReel } from "@/lab/reel/content";
import Filmstrip from "@/lab/reel/Filmstrip.astro";
import { styles } from "@/lab/reel/Home.styles";
import Quotes from "@/lab/reel/Quotes.astro";
import ReelShell from "@/lab/reel/ReelShell.astro";
import { getHome } from "@/lib/home";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";

const [site, home, { clips, press }] = await Promise.all([getSite(), getHome(), getReel()]);
---

<ReelShell expect="newsletter">
	<div {...sx(styles.hero)}>
		<div {...sx(styles.sinking)}>
			<Waterline site={site} home={home} />
		</div>
		<p aria-hidden="true" {...sx(styles.cue)}>Scroll to roll</p>
	</div>
	{clips.length > 0 && <Filmstrip clips={clips} />}
	{press.length > 0 && <Quotes press={press} />}
	<div {...sx(styles.over)}>
		<Newsletter home={home} />
	</div>
</ReelShell>
