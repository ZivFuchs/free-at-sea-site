---
import still from "@/assets/hero/barge-from-afar.jpg";
import Footer from "@/components/footer/Footer.astro";
import LabLayout from "@/lab/LabLayout.astro";
import { CLIP_CUTS, CUTS, type Cut, HORIZON } from "@/lab/scope/cuts";
import { shotMarker, styles } from "@/lab/scope/Scope.styles";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { newsletterForm } from "@/lib/newsletter";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);

const pad = (n: number) => String(n).padStart(2, "0");
const lastPoster = clips.at(-1)?.thumbnail ?? null;

interface Slot {
	cut: Cut;
	label: string;
}
const slots: Slot[] = [
	{ cut: "fade", label: site.title },
	{ cut: "match", label: "The line" },
	...clips.map((clip, i) => ({ cut: CLIP_CUTS[i % CLIP_CUTS.length] ?? "cut", label: clip.title })),
	...press.map(
		(item, i): Slot => ({
			cut: i === 0 && lastPoster ? "rack" : i % 2 ? "dissolve" : "cut",
			label: item.outlet,
		}),
	),
	{ cut: "dissolve", label: "Newsletter" },
];
const at = (i: number) => slots[i]?.cut ?? "cut";
const CLIPS_AT = 2;
const PRESS_AT = CLIPS_AT + clips.length;
const END_AT = PRESS_AT + press.length;
---

<LabLayout slug="scope">
	<main
		data-scope
		data-player-class={sx(styles.player).class}
		{...sx(styles.track)}
		style={{ "--n": slots.length, "--horizon": HORIZON }}
	>
		<div {...sx(styles.stage)}>
			<header {...sx(styles.bar)}>
				<a href="/" {...sx(styles.wordmark)}>{site.title}</a>
				<p {...sx(styles.readout)}>
					<span data-slate {...sx(styles.slate)}>Shot 01/{pad(slots.length)} · {CUTS.fade.label}</span>
					<span data-timecode aria-hidden="true" {...sx(styles.timecode)}>01:00:00:00</span>
				</p>
			</header>

			<div {...sx(styles.frame)}>
				<section data-shot data-cut={at(0)} data-state="current" aria-label="Opening" {...sx(shotMarker, styles.shot)} style="--o: 1; --q: 1">
					<div data-picture {...sx(styles.picture)}>
						<img
							src={home.heroPoster?.src ?? still.src}
							srcset={home.heroPoster?.srcset}
							sizes="100vw"
							alt="The barge alone on open sea, seen from far above"
							fetchpriority="high"
							{...sx(styles.media, styles.horizonAnchor, styles.push)}
						/>
						{home.heroVideo && (
							<video src={home.heroVideo} muted loop playsinline autoplay aria-hidden="true" {...sx(styles.media, styles.horizonAnchor, styles.push)} />
						)}
						<div {...sx(styles.titleBlock)}>
							<h1 {...sx(styles.title)}>{site.title}</h1>
						</div>
					</div>
					<p {...sx(styles.sub)}>
						{site.tagline}
						<span aria-hidden="true" {...sx(styles.hint)}>Scroll to roll</span>
					</p>
				</section>

				<section data-shot data-cut={at(1)} aria-label="The line" {...sx(shotMarker, styles.shot)}>
					<div data-picture {...sx(styles.picture)}>
						<div {...sx(styles.card, styles.cardUnderLine)}>
							<p {...sx(styles.eyebrow)}>200 nautical miles</p>
							<p {...sx(styles.cardText)}>Out here, the last national boundary ends.</p>
						</div>
					</div>
					<p {...sx(styles.sub)}>Past it lie the high seas, and the people trying to live on them.</p>
				</section>

				{clips.map((clip, i) => {
					const cut = at(CLIPS_AT + i);
					return (
						<section data-shot data-cut={cut} aria-label={`Clip ${i + 1}`} {...sx(shotMarker, styles.shot)}>
							<div data-picture {...sx(styles.picture, cut === "wipe" && styles.wipe)}>
								{clip.thumbnail && <img src={clip.thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.media, cut === "push" && styles.push)} />}
								<div {...sx(styles.scrim)} />
								<div {...sx(styles.third)}>
									<div>
										<p {...sx(styles.eyebrow)}>Clip {pad(i + 1)} / {pad(clips.length)}</p>
										<h2 {...sx(styles.clipTitle)}>{clip.title}</h2>
									</div>
									<a href={clip.url} data-embed={clip.embed} data-title={clip.title} {...sx(styles.play)}>
										<svg viewBox="0 0 12 14" aria-hidden="true" {...sx(styles.triangle)}>
											<path d="M0 0v14l12-7z" fill="currentColor" />
										</svg>
										Play
									</a>
								</div>
							</div>
							{clip.caption && <p {...sx(styles.sub)}>{clip.caption}</p>}
						</section>
					);
				})}

				{press.map((item, i) => {
					const cut = at(PRESS_AT + i);
					const rack = cut === "rack";
					return (
						<section data-shot data-cut={cut} aria-label={`Press: ${item.outlet}`} {...sx(shotMarker, styles.shot)}>
							<div data-picture {...sx(styles.picture)}>
								{rack && lastPoster && <img src={lastPoster} alt="" loading="lazy" decoding="async" {...sx(styles.media, styles.rackBack)} />}
								<div {...sx(styles.card, rack && styles.rackFront)}>
									<blockquote {...sx(styles.quote)}>“{item.quote ?? item.headline}”</blockquote>
									<p {...sx(styles.credit)}>
										<span>{[item.outlet, item.dateLabel].filter(Boolean).join(" · ")}</span>
										{item.url && <a href={item.url} target="_blank" rel="noopener" {...sx(styles.link)}>Read the piece</a>}
									</p>
								</div>
							</div>
							{item.quote && <p {...sx(styles.sub)}>{item.headline}</p>}
						</section>
					);
				})}

				<section data-shot data-cut={at(END_AT)} aria-labelledby="scope-newsletter" {...sx(shotMarker, styles.shot)}>
					<div data-picture {...sx(styles.picture)}>
						<div {...sx(styles.card)}>
							<p {...sx(styles.eyebrow)}>End of reel one</p>
							<h2 id="scope-newsletter" {...sx(styles.cardText)}>Word from the water</h2>
							<form {...newsletterForm()} {...sx(styles.form)}>
								<div {...sx(styles.field)}>
									<label for="scope-email" {...sx(styles.srOnly)}>Email address</label>
									<input id="scope-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required {...sx(styles.input)} />
									<button type="submit" {...sx(styles.submit)}>Subscribe</button>
								</div>
								<p data-newsletter-status aria-live="polite" {...sx(styles.status)}></p>
							</form>
						</div>
					</div>
					<p {...sx(styles.sub)}>Screenings and release news, as they happen.</p>
				</section>

				<div aria-hidden="true" {...sx(styles.horizon)}></div>
				<div aria-hidden="true" {...sx(styles.cue)}></div>
				<div aria-hidden="true" {...sx(styles.grain)}></div>
			</div>

			<div {...sx(styles.lower)}>
				<nav aria-label="Shots" {...sx(styles.scrub)}>
					<div aria-hidden="true" {...sx(styles.rail)}><div {...sx(styles.fill)}></div></div>
					{slots.map(({ label }, i) => (
						<button type="button" data-tick aria-label={`Shot ${i + 1}: ${label}`} aria-current={i === 0 ? "step" : undefined} {...sx(styles.tick)}>
							<span {...sx(styles.tickMark)}></span>
						</button>
					))}
				</nav>
			</div>
		</div>
	</main>
	<Footer />
</LabLayout>

<script>
	import "@/lib/newsletter.client";
	import { roll } from "@/lab/scope/timeline";

	for (const root of document.querySelectorAll<HTMLElement>("[data-scope]")) roll(root);
</script>
