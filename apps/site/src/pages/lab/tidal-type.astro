---
import LabLayout from "@/lab/LabLayout.astro";
import { rowMarker, styles } from "@/lab/tidal-type/TidalType.styles";
import { rowPath, SEA, seaRows, waveBox } from "@/lab/tidal-type/wave";
import { getClips } from "@/lib/clips";
import { NAV } from "@/lib/nav";
import { newsletterForm } from "@/lib/newsletter";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, clips, press] = await Promise.all([getSite(), getClips(), getPress()]);

const pad = (n: number) => String(n).padStart(2, "0");
const letters = (text: string) => text.split(" ").map((word) => [...word]);
function fill<T>(items: T[], min: number): T[] {
	return items.length
		? Array.from({ length: Math.max(min, items.length) }, (_, i) => items[i % items.length] as T)
		: [];
}

/** Horizon first, shore last: the sea's legal bands, with the film between them. */
const PHRASES = [
	"The high seas",
	site.title,
	"No flag · No shore · No border",
	"Exclusive economic zone · 200 nautical miles",
	...clips.slice(0, 2).map((clip) => clip.title),
	"International waters",
	"Contiguous zone · 24 nautical miles",
	site.tagline,
	"Seasteading",
	"Territorial sea · 12 nautical miles",
	site.title,
];
const ACCENT_ROW = 6;
const rows = seaRows().map((row, i) => {
	const phrase = PHRASES[i % PHRASES.length] ?? site.title;
	const repeats = Math.ceil((SEA.width * 2.6) / (row.size * 0.62 * (phrase.length + 6)));
	return { ...row, d: rowPath(row, 0), text: Array(repeats).fill(phrase).join("   ·   ") };
});

const STATEMENT = "Two hundred nautical miles out, the last border falls away.";
const sections = { clips: 1, press: 2, newsletter: 3 };
const outlets = fill(press.map((item) => item.outlet).filter(Boolean), 8);
const quotes = fill(
	press.map((item) => ({ words: item.quote ?? item.headline, by: item.outlet })),
	6,
);
const TIDE_REST = waveBox({ top: 38, bottom: 120, topAmp: 3, cycles: 1.4 });
const windowVars = {
	"--tt-shut": waveBox({ top: 100, bottom: 100 }),
	"--tt-open": waveBox({ top: 5, bottom: 95, topAmp: 2.6, bottomAmp: 2.6, cycles: 1.6 }),
};
const SHORE = { top: 2.5, bottom: 97.5, topAmp: 1.1, bottomAmp: 1.1, cycles: 1.7 };
const SUNK = { top: -40, bottom: 88, bottomAmp: 5, cycles: 2.2 };
const boxData = (box: Parameters<typeof waveBox>[0] & {}) =>
	Object.fromEntries(
		Object.entries(box).map(([key, value]) => [
			`data-${key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}`,
			value,
		]),
	);
---

<LabLayout slug="tidal-type">
	<main>
		<section data-tt-hero aria-label="Intro" {...sx(styles.hero)}>
			<nav aria-label="Main" {...sx(layout.container, styles.top)}>
				<a href="/lab/tidal-type" {...sx(styles.topHome)}>{site.title}</a>
				<ul {...sx(styles.topNav)}>
					{NAV.map(({ label, href }) => (
						<li><a href={href.replace("/", "")} {...sx(styles.topLink)}>{label}</a></li>
					))}
				</ul>
			</nav>

			<div {...sx(layout.container, styles.sky)}>
				<p {...sx(styles.tagline)}>{site.tagline}</p>
				<h1 {...sx(styles.title)}>
					<span {...sx(styles.srOnly)}>{site.title}</span>
					<span aria-hidden="true" data-tt-line>
						{letters(site.title).map((word, w) => (
							<Fragment>{w > 0 && " "}{word.map((char) => <span data-tt-letter {...sx(styles.letter)}>{char}</span>)}</Fragment>
						))}
					</span>
				</h1>
			</div>
			<div {...sx(styles.horizon)}></div>
			<div aria-hidden="true" {...sx(styles.water)}>
				<div {...sx(layout.container)}>
					<p data-tt-line {...sx(styles.title, styles.reflection)}>
						{letters(site.title).map((word, w) => (
							<Fragment>{w > 0 && " "}{word.map((char) => <span data-tt-letter {...sx(styles.letter)}>{char}</span>)}</Fragment>
						))}
					</p>
				</div>
				<svg viewBox={`0 0 ${SEA.width} ${SEA.height}`} preserveAspectRatio="xMidYMin slice" {...sx(styles.sea)}>
					{rows.map(({ d, text, size, opacity }, i) => (
						<Fragment>
							<path id={`tt-row-${i}`} data-tt-row d={d} {...sx(styles.seaLine)} />
							<text
								font-size={size.toFixed(1)}
								fill-opacity={opacity.toFixed(2)}
								{...sx(i % 2 ? styles.seaSerif : styles.seaSans, i === ACCENT_ROW ? styles.seaAccent : styles.seaFill)}
							>
								<textPath href={`#tt-row-${i}`}>{text}</textPath>
							</text>
						</Fragment>
					))}
				</svg>
			</div>
		</section>

		{clips.length > 0 && (
			<section id="clips" aria-labelledby="tt-clips" {...sx(layout.container, styles.section)}>
				<header {...sx(styles.head)}>
					<p aria-hidden="true" data-tt-tide {...sx(styles.tide)}>
						<span {...sx(styles.tideLine)}>{pad(sections.clips)}</span>
						<span data-tt-fill {...sx(styles.tideFill)} style={{ clipPath: TIDE_REST }}>{pad(sections.clips)}</span>
					</p>
					<div {...sx(styles.headWords)}>
						<p {...sx(styles.headNote)}>From the film · {clips.length} clips</p>
						<h2 id="tt-clips" {...sx(styles.heading)}>Clips</h2>
					</div>
				</header>
				<ol style={windowVars}>
					{clips.map(({ title, caption, url, thumbnail }, i) => (
						<li {...sx(styles.clip)}>
							<a href={url} target="_blank" rel="noopener" {...sx(rowMarker, styles.clipLink)}>
								<span {...sx(styles.clipNo)}>{pad(i + 1)}</span>
								<span {...sx(styles.clipTitle)}>{title}</span>
								<span {...sx(styles.clipPlay)}>Play ↗</span>
								{caption && <span {...sx(styles.clipCaption)}>{caption}</span>}
								{thumbnail && <img src={thumbnail} alt="" decoding="async" {...sx(styles.window)} />}
							</a>
						</li>
					))}
				</ol>
			</section>
		)}

		<section aria-label="The high seas" data-tt-wavebox {...boxData(SHORE)} {...sx(styles.shore)} style={{ clipPath: waveBox(SHORE) }}>
			<div {...sx(layout.container)}>
				<p {...sx(styles.shoreLabel)}>Where the map runs out</p>
				<p {...sx(styles.surf)}>
					<span {...sx(styles.srOnly)}>{STATEMENT}</span>
					<span aria-hidden="true" data-tt-surf>
						{letters(STATEMENT).map((word, w) => (
							<Fragment>{w > 0 && " "}<span {...sx(styles.word)}>{word.map((char) => <span data-tt-letter {...sx(styles.letter)}>{char}</span>)}</span></Fragment>
						))}
					</span>
				</p>
				<p {...sx(styles.shoreNote)}>
					Past every nation's waters lie the high seas: nearly two thirds of the ocean, belonging to no one.
					Seasteaders mean to live there.
				</p>
			</div>
		</section>

		{press.length > 0 && (
			<section id="press" aria-labelledby="tt-press" {...sx(styles.section)}>
				<div {...sx(layout.container)}>
					<header {...sx(styles.head)}>
						<p aria-hidden="true" data-tt-tide {...sx(styles.tide)}>
							<span {...sx(styles.tideLine)}>{pad(sections.press)}</span>
							<span data-tt-fill {...sx(styles.tideFill)} style={{ clipPath: TIDE_REST }}>{pad(sections.press)}</span>
						</p>
						<div {...sx(styles.headWords)}>
							<p {...sx(styles.headNote)}>What they wrote</p>
							<h2 id="tt-press" {...sx(styles.heading)}>Press</h2>
						</div>
					</header>
				</div>

				<div data-tt-currents {...sx(styles.currents)}>
					<div aria-hidden="true">
						<div data-tt-current data-speed="34" {...sx(styles.current)}>
							<div {...sx(styles.track)}>
								{[0, 1].map(() => (
									<div {...sx(styles.run)}>{outlets.map((name) => <span {...sx(styles.outlet)}>{name}</span>)}</div>
								))}
							</div>
						</div>
						<div data-tt-current data-speed="-52" {...sx(styles.current)}>
							<div {...sx(styles.track)}>
								{[0, 1].map(() => (
									<div {...sx(styles.run)}>
										{quotes.map(({ words, by }) => (
											<span {...sx(styles.quote)}>“{words}”<span {...sx(styles.quoteBy)}>{by}</span></span>
										))}
									</div>
								))}
							</div>
						</div>
						<div data-tt-current data-speed="18" {...sx(styles.current)}>
							<div {...sx(styles.track)}>
								{[0, 1].map(() => (
									<div {...sx(styles.run)}>
										{[...outlets].reverse().map((name) => <span {...sx(styles.outlet, styles.outletSolid)}>{name}</span>)}
									</div>
								))}
							</div>
						</div>
					</div>
					<div {...sx(layout.container)}>
						<button type="button" data-tt-pause aria-pressed="false" {...sx(styles.pause)}>Hold currents</button>
					</div>
				</div>

				<ol {...sx(layout.container, styles.ledger)}>
					{press.map(({ outlet, headline, url, dateLabel }) => (
						<li {...sx(styles.entry)}>
							<a href={url} target="_blank" rel="noopener" {...sx(rowMarker, styles.entryLink)}>
								<span {...sx(styles.entryOutlet)}>{outlet}</span>
								<span {...sx(styles.entryHeadline)}>{headline}</span>
								<span {...sx(styles.entryDate)}>{dateLabel}</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		)}

		<section id="newsletter" aria-labelledby="tt-newsletter" {...sx(layout.container, styles.section)}>
			<header {...sx(styles.head)}>
				<p aria-hidden="true" data-tt-tide {...sx(styles.tide)}>
					<span {...sx(styles.tideLine)}>{pad(sections.newsletter)}</span>
					<span data-tt-fill {...sx(styles.tideFill)} style={{ clipPath: TIDE_REST }}>{pad(sections.newsletter)}</span>
				</p>
				<div {...sx(styles.headWords)}>
					<p {...sx(styles.headNote)}>Join the newsletter</p>
					<h2 id="tt-newsletter" {...sx(styles.heading)}>Word from the water</h2>
				</div>
			</header>
			<div {...sx(styles.letterGrid)}>
				<p {...sx(styles.letterLede)}>Screenings, the release, and news from the open sea.</p>
				<form {...newsletterForm()}>
					<div {...sx(styles.field)}>
						<label for="tt-email" {...sx(styles.srOnly)}>Email address</label>
						<input id="tt-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required {...sx(styles.input)} />
						<button type="submit" {...sx(styles.submit)}>Subscribe →</button>
					</div>
					<p data-newsletter-status aria-live="polite" {...sx(styles.status)}></p>
				</form>
			</div>
		</section>
	</main>

	<footer {...sx(styles.footer)}>
		<div {...sx(layout.container)}>
			<div {...sx(styles.colophon)}>
				<div>
					<p {...sx(styles.colHead)}>Film</p>
					<span {...sx(styles.colText)}>{site.title}</span>
					<span {...sx(styles.colText)}>{site.tagline}</span>
				</div>
				<nav aria-label="Footer">
					<p {...sx(styles.colHead)}>Index</p>
					{NAV.map(({ label, href }) => <a href={href.replace("/", "")} {...sx(styles.colLink)}>{label}</a>)}
				</nav>
				<div>
					<p {...sx(styles.colHead)}>Contact</p>
					{site.email ? <a href={`mailto:${site.email}`} {...sx(styles.colLink)}>{site.email}</a> : <span {...sx(styles.colText)}>Soon</span>}
				</div>
				<div>
					<p {...sx(styles.colHead)}>Colophon</p>
					<span {...sx(styles.colText)}>Set in Playfair Display</span>
					<span {...sx(styles.colText)}>© {new Date().getFullYear()}</span>
				</div>
			</div>
			<p aria-hidden="true" data-tt-wavebox {...boxData(SUNK)} {...sx(styles.sunk)} style={{ clipPath: waveBox(SUNK) }}>{site.title}</p>
		</div>
	</footer>
</LabLayout>

<script>
	import "@/lib/newsletter.client";
	import "@/lab/tidal-type/client";
</script>
