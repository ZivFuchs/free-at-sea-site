---
import still from "@/assets/hero/barge-from-afar.jpg";
import HeroMedia from "@/components/hero/HeroMedia.astro";
import LabLayout from "@/lab/LabLayout.astro";
import { marker, styles } from "@/lab/swash/Swash.styles";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { newsletterForm } from "@/lib/newsletter";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const HORIZON = 0.178;
const PRESS_SHOWN = 4;
const notices = press.slice(0, PRESS_SHOWN);

const slides = [
	{ id: "top", label: site.title },
	{ id: "idea", label: "The idea" },
	...clips.map(({ title }, i) => ({ id: `clip-${i + 1}`, label: title })),
	...(notices.length > 0 ? [{ id: "press", label: "Press" }] : []),
	{ id: "newsletter", label: "Newsletter" },
];

function pad(n: number) {
	return String(n).padStart(2, "0");
}
---

<LabLayout slug="swash">
	<header {...sx(styles.chrome, styles.bar)}>
		<a href="#top" data-swash-dot-home {...sx(styles.wordmark)}>{site.title}</a>
		<p {...sx(styles.count)} aria-hidden="true">
			<span data-swash-count>01</span> / {pad(slides.length)}
		</p>
	</header>

	<nav aria-label="Pages" {...sx(styles.chrome, styles.rail)}>
		{
			slides.map(({ id, label }, i) => (
				<a href={`#${id}`} data-swash-dot aria-label={label} aria-current={i === 0 ? "true" : undefined} {...sx(marker, styles.dot)}>
					<span aria-hidden="true" {...sx(styles.dotLabel)}>{label}</span>
					<span {...sx(styles.pip)} />
				</a>
			))
		}
	</nav>

	<main data-swash-root {...sx(marker, styles.scroller)}>
		<div {...sx(styles.track)} style={{ "--slides": slides.length }}>
			<div {...sx(styles.stage)}>
				<section id="top" data-slide data-ready aria-label="Intro" {...sx(marker, styles.slide, styles.photo)} style={{ "--horizon": HORIZON }}>
					<HeroMedia
						image={still}
						alt="The barge alone on open sea, seen from far above"
						video={home.heroVideo}
						poster={home.heroPoster}
						horizon={HORIZON}
					/>
					<div {...sx(styles.heroCopy)}>
						<h1 {...sx(styles.heroTitle)}>{site.title}</h1>
						<p {...sx(styles.heroTagline)}>{site.tagline}</p>
					</div>
					<p aria-hidden="true" {...sx(styles.hint)}>Swipe up</p>
				</section>

				<section id="idea" data-slide aria-labelledby="idea-heading" {...sx(styles.slide, styles.sand)}>
					<div {...sx(styles.inner)}>
						<p {...sx(styles.eyebrow, styles.lagoon)}>The idea</p>
						<h2 id="idea-heading" {...sx(styles.display)}>Every claim on the sea ends somewhere.</h2>
						<p {...sx(styles.lede, styles.inkSoft)}>
							Two hundred nautical miles from the coast, the last national line gives out. Past it are the high
							seas, which belong to no one. Seasteading is the plan to make a home there.
						</p>
					</div>
				</section>

				{
					clips.map(({ title, caption, url, embed, thumbnail }, i) => (
						<section id={`clip-${i + 1}`} data-slide aria-label={`Clip: ${title}`} {...sx(styles.slide, styles.photo)}>
							{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.poster)} />}
							<div {...sx(styles.scrim)} />
							<div {...sx(styles.inner, styles.low)}>
								<p {...sx(styles.eyebrow, styles.aqua)}>
									Clip {pad(i + 1)} / {pad(clips.length)}
								</p>
								<h2 {...sx(styles.clipTitle)}>{title}</h2>
								{caption && <p {...sx(styles.caption)}>{caption}</p>}
								<a href={url} target="_blank" rel="noopener" data-embed={embed} data-title={title} {...sx(styles.play)}>
									<span {...sx(styles.playRing)}>
										<svg viewBox="0 0 12 14" aria-hidden="true" {...sx(styles.triangle)}>
											<path d="M0 0v14l12-7z" fill="currentColor" />
										</svg>
									</span>
									Play clip
								</a>
							</div>
							<div data-frame data-fill={sx(styles.player).class} {...sx(styles.frame)} />
						</section>
					))
				}

				{
					notices.length > 0 && (
						<section id="press" data-slide aria-labelledby="press-heading" {...sx(styles.slide, styles.sand)}>
							<div {...sx(styles.inner)}>
								<p {...sx(styles.eyebrow, styles.lagoon)}>Washed up</p>
								<h2 id="press-heading" {...sx(styles.display)}>Press</h2>
								<ul {...sx(styles.pressList)}>
									{notices.map(({ headline, url, outlet, dateLabel }) => (
										<li {...sx(styles.pressItem)}>
											<a href={url} target="_blank" rel="noopener" {...sx(styles.pressLink)}>
												<span {...sx(styles.outlet)}>{[outlet, dateLabel].filter(Boolean).join(" · ")}</span>
												<span {...sx(styles.headline)}>{headline}</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						</section>
					)
				}

				<section id="newsletter" data-slide aria-labelledby="swash-newsletter-heading" {...sx(styles.slide, styles.deep)}>
					<div {...sx(styles.inner)}>
						<p {...sx(styles.eyebrow, styles.aqua)}>Join the newsletter</p>
						<h2 id="swash-newsletter-heading" {...sx(styles.display)}>Word from the water</h2>
						<form {...newsletterForm()} {...sx(styles.form)}>
							<div {...sx(styles.field)}>
								<label for="swash-email" {...sx(styles.srOnly)}>Email address</label>
								<input id="swash-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required {...sx(styles.input)} />
								<button type="submit" aria-label="Subscribe" {...sx(styles.submit)}>
									<svg viewBox="0 0 16 16" aria-hidden="true" {...sx(styles.arrow)}>
										<path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
									</svg>
								</button>
							</div>
							<p data-newsletter-status aria-live="polite" {...sx(styles.status)}></p>
						</form>
						<p {...sx(styles.colophon)}>
							<span>© {new Date().getFullYear()} {site.title}</span>
							{site.email && <a href={`mailto:${site.email}`} {...sx(styles.colophonLink)}>Contact</a>}
						</p>
					</div>
				</section>

				<canvas aria-hidden="true" {...sx(styles.canvas)}></canvas>
			</div>
			{slides.map((_, i) => <div aria-hidden="true" {...sx(styles.stop)} style={{ "--i": i }} />)}
		</div>
	</main>
</LabLayout>

<script>
	import "@/lib/newsletter.client";
	import "@/lab/swash/swash.client";
</script>
