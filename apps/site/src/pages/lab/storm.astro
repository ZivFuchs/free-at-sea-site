---
import { getImage } from "astro:assets";
import still from "@/assets/hero/barge-from-afar.jpg";
import Clips from "@/components/clips/Clips.astro";
import Footer from "@/components/footer/Footer.astro";
import Header from "@/components/header/Header.astro";
import { styles as hero, heroMarker } from "@/components/hero/Waterline.styles";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import Press from "@/components/press/Press.astro";
import LabLayout from "@/lab/LabLayout.astro";
import { styles } from "@/lab/storm/Storm.styles";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press, fallback] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
	getImage({ src: still, width: 1920 }),
]);
const HORIZON = 0.178;
const scene = home.heroPoster?.src ?? fallback.src;
---

<LabLayout slug="storm">
	<div
		data-storm
		data-scene={scene}
		data-fallback={fallback.src}
		data-video={home.heroVideo}
		data-horizon={HORIZON}
		aria-hidden="true"
		{...sx(styles.backdrop)}
		style={{ "--horizon": HORIZON }}
	>
		<img src={scene} srcset={home.heroPoster?.srcset} sizes="100vw" alt="" fetchpriority="high" {...sx(styles.fill, styles.still)} />
		<div {...sx(styles.fill, styles.veil)}></div>
		<canvas {...sx(styles.fill, styles.canvas)}></canvas>
	</div>

	<div {...sx(styles.shell)}>
		<Header overlay />
		<main id="main" {...sx(styles.main)}>
			<section aria-label="Intro" data-storm-hero {...sx(heroMarker, styles.hero)} style={{ "--horizon": HORIZON }}>
				<div {...sx(hero.copy)}>
					<h1 data-hero-title data-hero-fade {...sx(hero.text, hero.title)}>{site.title}</h1>
					<p data-hero-fade {...sx(hero.text, hero.tagline)}>{site.tagline}</p>
				</div>
			</section>

			<section aria-labelledby="weather-heading" {...sx(styles.passage)}>
				<div {...sx(layout.container)}>
					<div {...sx(styles.pane)}>
						<p {...sx(styles.eyebrow)}>Weather</p>
						<h2 id="weather-heading" {...sx(styles.heading)}>Nobody owns the weather either.</h2>
						<p {...sx(styles.body)}>
							A settlement in international waters answers to no coast, and to every front that crosses it.
							Out there a forecast is not small talk. You watch the glass, tie down what moves, and wait.
						</p>
					</div>
				</div>
			</section>

			<div {...sx(styles.band)}>
				<Clips clips={clips} />
			</div>
			<section aria-label="Squall" {...sx(styles.window)}>
				<p {...sx(layout.container, styles.log)}>Wind backing, rain heavy. Visibility poor.</p>
			</section>
			<div {...sx(styles.band)}>
				<Press items={press} />
			</div>
			<Newsletter home={home} />

			<section aria-label="After the squall" data-storm-clearing {...sx(styles.clearing)}>
				<div {...sx(layout.container)}>
					<h2 {...sx(styles.passes)}>It passes.</h2>
					<p {...sx(styles.after)}>The deck dries, the horizon comes back, and the work goes on.</p>
				</div>
			</section>
		</main>
		<Footer />
	</div>

	<p aria-hidden="true" {...sx(styles.readout)}>
		<span><span data-storm-baro {...sx(styles.figure)}>1017</span> hPa</span>
		<span {...sx(styles.wide)}><span data-storm-wind {...sx(styles.figure)}>06</span> kn</span>
		<span data-storm-state>Fair</span>
	</p>
</LabLayout>

<script>
	import { storm } from "@/lab/storm/storm.client";

	for (const root of document.querySelectorAll<HTMLElement>("[data-storm]")) storm(root);
</script>
