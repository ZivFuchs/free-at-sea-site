---
import { formMarker, styles as newsletter } from "@/components/newsletter/Newsletter.styles";
import LabLayout from "@/lab/LabLayout.astro";
import { linkMarker, styles } from "@/lab/shoal/Shoal.styles";
import { getClips } from "@/lib/clips";
import { NAV } from "@/lib/nav";
import { newsletterForm } from "@/lib/newsletter";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, clips, press] = await Promise.all([getSite(), getClips(), getPress()]);
const pad = (n: number) => String(n).padStart(2, "0");
const words = site.title.split(" ");
const local = NAV.map(({ label, href }) => ({ label, href: href.replace("/", "") }));
---

<LabLayout slug="shoal">
	<div data-shoal {...sx(styles.root)}>
		<div aria-hidden="true" {...sx(styles.water)}><div {...sx(styles.dark)}></div></div>
		<canvas aria-hidden="true" {...sx(styles.canvas)}></canvas>

		<header {...sx(layout.container, styles.bar)}>
			<a href="/lab/shoal" {...sx(styles.mark)}>{site.title}</a>
			<nav aria-label="Main" {...sx(styles.nav)}>
				{local.map(({ label, href }) => <a href={href} {...sx(styles.navLink)}>{label}</a>)}
			</nav>
		</header>

		<main>
			<section aria-label="Intro" {...sx(layout.container, styles.hero)}>
				<h1 data-shoal-title data-formation="title" {...sx(styles.title)}>
					{words.map((word, i) => (
						<Fragment>
							<span data-word {...sx(styles.word)}>{word}</span>
							{i < words.length - 1 && " "}
						</Fragment>
					))}
				</h1>
				<p {...sx(styles.tagline)}>{site.tagline}</p>
				<p aria-hidden="true" {...sx(styles.hint)}>Reach in</p>
			</section>

			<section aria-labelledby="premise" {...sx(layout.container, styles.section)}>
				<div data-formation="line" aria-hidden="true" {...sx(styles.horizon)}></div>
				<p {...sx(styles.eyebrow)}>The premise</p>
				<h2 id="premise" {...sx(styles.premise)}>Nearly half the planet lies beyond any nation's border.</h2>
				<p {...sx(styles.premiseNote)}>
					Past two hundred nautical miles the sea belongs to no one. This film follows the people trying to build
					homes there.
				</p>
			</section>

			{
				clips.length > 0 && (
					<section id="clips" aria-labelledby="clips-heading" {...sx(layout.container, styles.section)}>
						<div data-formation="ring" {...sx(styles.halo)}>
							<h2 id="clips-heading" {...sx(styles.heading)}>Clips</h2>
							<p {...sx(styles.headingNote)}>First footage from the water</p>
						</div>
						<ul {...sx(styles.clips)}>
							{clips.map(({ title, caption, url, thumbnail }, i) => (
								<li>
									<a href={url} target="_blank" rel="noopener" {...sx(linkMarker, styles.clip)}>
										<div {...sx(styles.frame)}>
											{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.poster)} />}
										</div>
										<div {...sx(styles.clipMeta)}>
											<span {...sx(styles.index)}>{pad(i + 1)}</span>
											<div>
												<h3 {...sx(styles.clipTitle)}>{title}</h3>
												{caption && <p {...sx(styles.clipCaption)}>{caption}</p>}
											</div>
										</div>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				press.length > 0 && (
					<section id="press" aria-labelledby="press-heading" {...sx(layout.container, styles.section)}>
						<div data-formation="stream" {...sx(styles.pressHead)}>
							<h2 id="press-heading" {...sx(styles.heading)}>Press</h2>
							<p {...sx(styles.headingNote)}>What has been written so far</p>
						</div>
						<ul {...sx(styles.pressList)}>
							{press.map(({ outlet, headline, url, quote, date, dateLabel }) => (
								<li>
									<a href={url} target="_blank" rel="noopener" {...sx(linkMarker, styles.pressItem)}>
										<span {...sx(styles.outlet)}>{outlet}</span>
										<span>
											<h3 {...sx(styles.headline)}>{headline}</h3>
											{quote && <p {...sx(styles.quote)}>“{quote}”</p>}
										</span>
										{date && <time datetime={date} {...sx(styles.date)}>{dateLabel}</time>}
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<section id="newsletter" aria-labelledby="newsletter-heading" {...sx(layout.container, styles.section)}>
				<div {...sx(styles.well)}>
				<div data-formation="vortex" {...sx(styles.eye)}>
					<h2 id="newsletter-heading" {...sx(styles.eyeHeading)}>Word from the water</h2>
					<p {...sx(styles.eyeNote)}>Join the newsletter</p>
					<form {...newsletterForm()} {...sx(formMarker, newsletter.form)}>
						<div {...sx(newsletter.field)}>
							<label for="shoal-email" {...sx(newsletter.srOnly)}>Email address</label>
							<input
								id="shoal-email"
								type="email"
								name="email"
								autocomplete="email"
								placeholder="you@example.com"
								required
								{...sx(newsletter.input)}
							/>
							<button type="submit" aria-label="Subscribe" {...sx(newsletter.button)}>
								<svg viewBox="0 0 16 16" aria-hidden="true" {...sx(newsletter.arrow)}>
									<path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
								</svg>
							</button>
						</div>
						<div {...sx(newsletter.statusRow)}>
							<svg viewBox="0 0 16 16" aria-hidden="true" {...sx(newsletter.check)}>
								<path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" />
							</svg>
							<p data-newsletter-status aria-live="polite" {...sx(newsletter.status)}></p>
						</div>
					</form>
				</div>
				</div>
			</section>
		</main>

		<footer data-formation="scatter" {...sx(layout.container, styles.footer)}>
			<a href="/lab/shoal" {...sx(styles.footMark)}>{site.title}</a>
			<p {...sx(styles.legal)}>© {new Date().getFullYear()} {site.title}</p>
		</footer>
	</div>
</LabLayout>

<script>
	import "@/lib/newsletter.client";
	import "@/lab/shoal/shoal.client";
</script>
