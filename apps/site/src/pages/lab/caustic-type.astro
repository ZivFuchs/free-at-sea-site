---
import Clips from "@/components/clips/Clips.astro";
import Footer from "@/components/footer/Footer.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import Press from "@/components/press/Press.astro";
import { rootMarker, styles } from "@/lab/caustic-type/Page.styles";
import { css, GROUND } from "@/lab/caustic-type/palette";
import LabLayout from "@/lab/LabLayout.astro";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { NAV } from "@/lib/nav";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const ground = Object.entries(GROUND)
	.map(([name, rgb]) => `--${name}: ${css(rgb)}`)
	.join(";");
/* Words are wrapped so the light can be aimed at each exactly where the browser set it. */
function words(text: string) {
	return text.split(" ");
}
---

<LabLayout slug="caustic-type">
	<div data-caustics {...sx(rootMarker, styles.root)} style={ground}>
		<canvas aria-hidden="true" {...sx(styles.canvas)}></canvas>

		<header {...sx(styles.header)}>
			<a href="/lab/caustic-type" {...sx(styles.wordmark)}>{site.title}</a>
			<nav aria-label="Main" {...sx(styles.nav)}>
				{NAV.map(({ label, href }) => <a href={href.replace("/", "")} {...sx(styles.link)}>{label}</a>)}
			</nav>
		</header>

		<main>
			<section aria-label="Intro" {...sx(styles.hero)}>
				<h1 data-light="loop" {...sx(styles.title)}>
					{words(site.title).map((word) => <Fragment><span data-word>{word}</span>{" "}</Fragment>)}
				</h1>
				<p {...sx(styles.tagline)}>{site.tagline}</p>
				<p aria-hidden="true" {...sx(styles.hint)}>Touch the water</p>
			</section>

			<section aria-labelledby="shelf-heading" {...sx(styles.shelf)}>
				<div {...sx(layout.container)}>
					<div {...sx(styles.column)}>
						<p {...sx(styles.eyebrow)}>The film</p>
						<h2 id="shelf-heading" data-light="once" {...sx(styles.line)}>
							{words("A home on open water").map((word) => <Fragment><span data-word>{word}</span>{" "}</Fragment>)}
						</h2>
						<p {...sx(styles.body)}>
							Seasteading is the attempt to build permanent settlements on the ocean, beyond the reach of any coast. This
							film follows the people trying it, and what the sea makes of their plans.
						</p>
					</div>
				</div>
			</section>

			<section data-drop aria-labelledby="drop-heading" {...sx(styles.drop)}>
				<div {...sx(layout.container)}>
					<h2 id="drop-heading" data-light="once" {...sx(styles.line, styles.dropLine)}>
						{words("Past the shelf, no nation").map((word) => <Fragment><span data-word>{word}</span>{" "}</Fragment>)}
					</h2>
				</div>
			</section>

			<div {...sx(styles.deep)}>
				<Clips clips={clips} />
				<Press items={press} />
				<Newsletter home={home} />
			</div>
		</main>
		<Footer />
	</div>
</LabLayout>

<script>
	import { stage } from "@/lab/caustic-type/stage";

	for (const root of document.querySelectorAll<HTMLElement>("[data-caustics]")) stage(root);
</script>
