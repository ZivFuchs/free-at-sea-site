---
import still from "@/assets/hero/barge-from-afar.jpg";
import Footer from "@/components/footer/Footer.astro";
import HeroMedia from "@/components/hero/HeroMedia.astro";
import { heroMarker } from "@/components/hero/Waterline.styles";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import Press from "@/components/press/Press.astro";
import { clipMarker, styles } from "@/lab/glass/Glass.styles";
import LabLayout from "@/lab/LabLayout.astro";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { NAV } from "@/lib/nav";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const HORIZON = 0.178;
const pad = (n: number) => String(n).padStart(2, "0");
---

<LabLayout slug="glass">
	<nav aria-label="Main" data-lens="bezel" data-strength="10" {...sx(styles.nav)}>
		<a href="#top" {...sx(styles.wordmark)}>{site.title}</a>
		{NAV.map(({ label, href }) => <a href={href.slice(1)} {...sx(styles.navLink)}>{label}</a>)}
	</nav>

	<main id="top">
		<section aria-label="Intro" data-glass-hero data-ready {...sx(heroMarker, styles.hero)}>
			<HeroMedia
				image={still}
				alt="The barge alone on open sea, seen from far above"
				video={home.heroVideo}
				poster={home.heroPoster}
				horizon={HORIZON}
			/>
			<div {...sx(styles.copy)}>
				<h1 {...sx(styles.title)}>{site.title}</h1>
				<p {...sx(styles.tagline)}>{site.tagline}</p>
			</div>
			<a href="#clips" data-lens="bezel" data-strength="9" {...sx(styles.cta)}>Watch the clips</a>
			<div data-water aria-hidden="true" {...sx(styles.water)}></div>
			<canvas data-drops aria-hidden="true" {...sx(styles.drops)}></canvas>
		</section>

		<section aria-labelledby="passage-heading" data-passage {...sx(styles.passage)}>
			<div {...sx(layout.container)}>
				<div {...sx(styles.measure)}>
					<p id="passage-heading" {...sx(styles.eyebrow)}>Past the last border</p>
					<p {...sx(styles.lede)}>
						Two hundred nautical miles from any coast, the sea stops belonging to anyone. A few people are
						trying to build homes there.
					</p>
					<p {...sx(styles.body)}>
						They call it seasteading: floating settlements in international waters, small enough to start
						with a single platform and free to try new ways of living together. Free at Sea follows them
						out.
					</p>
				</div>
			</div>
			<div data-band data-lens="band" aria-hidden="true" {...sx(styles.band)}></div>
		</section>

		{
			clips.length > 0 && (
				<section id="clips" aria-labelledby="clips-heading" {...sx(styles.clips)}>
					<div {...sx(layout.container)}>
						<h2 id="clips-heading" {...sx(styles.heading)}>Clips</h2>
						<ul {...sx(styles.grid)}>
							{clips.map(({ title, url, thumbnail }, i) => (
								<li>
									<a href={url} target="_blank" rel="noopener" aria-label={`Play ${title}`} {...sx(clipMarker, styles.clip)}>
										<div {...sx(styles.frame)}>
											{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.poster)} />}
											<div data-meniscus data-lens="dome" data-strength="28" {...sx(styles.meniscus)} />
										</div>
										<p {...sx(styles.caption)}>
											<span {...sx(styles.index)}>{pad(i + 1)}</span>
											<span {...sx(styles.clipTitle)}>{title}</span>
										</p>
									</a>
								</li>
							))}
						</ul>
						<p data-support {...sx(styles.note)}></p>
					</div>
				</section>
			)
		}

		<Press items={press} />
		<Newsletter home={home} />
	</main>
	<Footer />
</LabLayout>

<script>
	import { mountDrops } from "@/lab/glass/drops";
	import { type LensShape, mountLens, refracts } from "@/lab/glass/lens";
	import { elementProgress, smoothstep } from "@/lab/lib/motion";

	const bends = refracts();

	const hero = document.querySelector<HTMLElement>("[data-glass-hero]");
	const water = hero?.querySelector<HTMLElement>("[data-water]");
	const canvas = hero?.querySelector<HTMLCanvasElement>("[data-drops]");
	if (hero && water && canvas) mountDrops(hero, water, canvas);

	if (bends) {
		for (const lens of document.querySelectorAll<HTMLElement>("[data-lens]")) {
			mountLens(lens, lens.dataset.lens as LensShape, Number(lens.dataset.strength ?? 0));
		}
	}

	const passage = document.querySelector<HTMLElement>("[data-passage]");
	const band = passage?.querySelector<HTMLElement>("[data-band]");
	if (passage && band) {
		let frame = 0;
		const slide = () => {
			frame = 0;
			const travel = passage.offsetHeight - band.offsetHeight;
			band.style.setProperty("--y", `${smoothstep(0.22, 0.78, elementProgress(passage)) * travel}px`);
		};
		const queue = () => (frame ||= requestAnimationFrame(slide));
		slide();
		addEventListener("scroll", queue, { passive: true });
		addEventListener("resize", queue);
	}

	// Touch has no hover: a clip's water drains once it sits in the middle of the screen.
	if (matchMedia("(hover: none)").matches) {
		const centred = new IntersectionObserver(
			(entries) => {
				for (const { target, isIntersecting } of entries) target.toggleAttribute("data-flat", isIntersecting);
			},
			{ rootMargin: "-38% 0px -38% 0px" },
		);
		for (const meniscus of document.querySelectorAll("[data-meniscus]")) centred.observe(meniscus);
	}

	const support = document.querySelector("[data-support]");
	if (support) {
		support.textContent = bends
			? "Refraction is live: every lens on this page bends the real page beneath it."
			: "This browser cannot bend the page through a lens, so the glass is frosted instead. Open in Chrome or Edge for the refraction.";
	}
</script>
