---
import Clips from "@/components/clips/Clips.astro";
import Footer from "@/components/footer/Footer.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import Press from "@/components/press/Press.astro";
import { styles } from "@/lab/jelly/Jelly.styles";
import LabLayout from "@/lab/LabLayout.astro";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { NAV } from "@/lib/nav";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const [first, ...rest] = site.title.split(" ");
---

<LabLayout slug="jelly">
	<div {...sx(styles.ground)}>
		<canvas data-medusae aria-hidden="true" {...sx(styles.canvas)}></canvas>

		<header {...sx(layout.container, styles.header)}>
			<a href="/lab/jelly" {...sx(styles.wordmark)}>{site.title}</a>
			<nav aria-label="Main" {...sx(styles.nav)}>
				{NAV.map(({ label, href }) => <a href={href.replace(/^\//, "")} {...sx(styles.link)}>{label}</a>)}
			</nav>
		</header>

		<main>
			<section aria-label="Intro" {...sx(layout.container, styles.hero)}>
				<h1 {...sx(styles.title)}>{first}{" "}<br {...sx(styles.turn)} />{rest.join(" ")}</h1>
				<p {...sx(styles.tagline)}>{site.tagline}</p>
				<p {...sx(layout.container, styles.label)}>
					<span><span aria-hidden="true" {...sx(styles.rule)}></span><i>Aurelia aurita</i> · moon jellyfish</span>
				</p>
			</section>

			<section aria-labelledby="high-seas" {...sx(layout.container, styles.passage)}>
				<div {...sx(styles.measure)}>
					<p {...sx(styles.eyebrow)}>The high seas</p>
					<h2 id="high-seas" {...sx(styles.statement)}>Nothing out here asks permission.</h2>
					<p {...sx(styles.prose)}>
						Two hundred nautical miles from any coast, national waters end. What lives beyond them goes where the
						current goes. {site.title} follows the people who want to live there too: seasteaders, building homes on
						open water.
					</p>
				</div>
			</section>

			<div {...sx(styles.sections)}>
				<Clips clips={clips} />
				<Press items={press} />
				<Newsletter home={home} />
			</div>
		</main>
		<Footer />
	</div>
</LabLayout>

<script>
	import { startMedusae } from "@/lab/jelly/scene";

	const canvas = document.querySelector<HTMLCanvasElement>("canvas[data-medusae]");
	const stop = canvas && startMedusae(canvas);
	if (canvas && stop) {
		canvas.setAttribute("data-live", "");
		addEventListener("pagehide", stop, { once: true });
	}
</script>
