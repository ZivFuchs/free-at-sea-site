---
import { Image } from "astro:assets";
import still from "@/assets/hero/barge-from-afar.jpg";
import Clips from "@/components/clips/Clips.astro";
import Footer from "@/components/footer/Footer.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import Press from "@/components/press/Press.astro";
import LabLayout from "@/lab/LabLayout.astro";
import { styles } from "@/lab/sea-legs/SeaLegs.styles";
import Station from "@/lab/sea-legs/Station.astro";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const HORIZON = 0.178;
const ALT = "The barge alone on open sea, seen from far above";
/** `line` (rem) is how far each link hangs below the rule. */
const nav = [
	{ label: "Clips", href: "#clips", line: 0.9 },
	{ label: "Press", href: "#press", line: 1.7 },
	{ label: "Newsletter", href: "#newsletter", line: 1.2 },
];
---

<LabLayout slug="sea-legs">
	<div data-sea-legs {...sx(styles.sea)}>
		<div data-deck {...sx(styles.deck)}>
			<header {...sx(styles.header, home.heroBackdrop === "light" && styles.headerInk)}>
				<div {...sx(layout.container)}>
					<div {...sx(styles.bar)}>
						<a href="/lab/sea-legs" {...sx(styles.wordmark)}>{site.title}</a>
						<nav aria-label="Main">
							<ul {...sx(styles.nav)}>
								{
									nav.map(({ label, href, line }) => (
										<li data-hang={line} {...sx(styles.hang)} style={{ "--line": `${line}rem` }}>
											<span aria-hidden="true" {...sx(styles.line)} />
											<a href={href} {...sx(styles.navLink)}>
												{label}
											</a>
										</li>
									))
								}
							</ul>
						</nav>
					</div>
				</div>
			</header>

			<main>
				<section aria-label="Intro" {...sx(styles.hero)} style={{ "--horizon": HORIZON }}>
					<div data-scene {...sx(styles.scene)}>
						{
							home.heroPoster ? (
								<img
									src={home.heroPoster.src}
									srcset={home.heroPoster.srcset}
									sizes="130vw"
									alt={ALT}
									loading="eager"
									fetchpriority="high"
									{...sx(styles.media)}
								/>
							) : (
								<Image
									src={still}
									alt={ALT}
									widths={[768, 1280, 1920, 2880]}
									sizes="130vw"
									loading="eager"
									fetchpriority="high"
									{...sx(styles.media)}
								/>
							)
						}
						{
							home.heroVideo && (
								<video
									data-sea-video
									data-src={home.heroVideo}
									muted
									loop
									playsinline
									aria-hidden="true"
									{...sx(styles.media, styles.video)}
								/>
							)
						}
						<div {...sx(styles.copy)}>
							<h1 {...sx(styles.title)}>{site.title}</h1>
							<p {...sx(styles.tagline)}>{site.tagline}</p>
						</div>
					</div>
					<div {...sx(styles.foot)}>
						<button type="button" data-ask hidden {...sx(styles.button)}>Find your sea legs</button>
						<p data-hint {...sx(styles.hint)}>The deck rolls. The horizon holds.</p>
					</div>
				</section>

				<Station label="01" />
				<section aria-labelledby="sea-legs-heading" {...sx(layout.container, styles.passage)}>
					<p {...sx(styles.eyebrow)}>Sea legs</p>
					<h2 id="sea-legs-heading" {...sx(styles.heading)}>Out here the horizon is the only thing that holds still.</h2>
					<p {...sx(styles.body)}>
						On a floating home nothing is quite level: the table, the lamp, the page you are reading. After a few
						days the body stops minding. Sailors call it getting your sea legs.
					</p>
				</section>

				<Station label="02" line={1.6} />
				<Clips clips={clips} />
				<Station label="03" line={1.1} />
				<Press items={press} />
				<Station label="04" line={1.4} />
				<Newsletter home={home} />
			</main>
			<Footer />
		</div>

		<aside aria-label="Inclinometer" {...sx(styles.gauge)}>
			<svg viewBox="-20 -20 40 40" aria-hidden="true" {...sx(styles.dial)}>
				<clipPath id="sea-legs-dial"><circle r="17" /></clipPath>
				<g clip-path="url(#sea-legs-dial)">
					<g data-dial>
						<rect x="-40" y="0" width="80" height="40" {...sx(styles.dialSea)} />
						<line x1="-40" x2="40" {...sx(styles.dialLine)} />
					</g>
				</g>
				<circle r="17" {...sx(styles.dialRim)} />
				<path d="M-11 0h6M5 0h6M0 -1.5v3" fill="none" {...sx(styles.dialMark)} />
			</svg>
			<dl {...sx(styles.readout)}>
				<dt {...sx(styles.term)}>Roll</dt>
				<dd data-roll {...sx(styles.value)}>+0.0°</dd>
				<dt {...sx(styles.term)}>Pitch</dt>
				<dd data-pitch {...sx(styles.value)}>+0.0°</dd>
			</dl>
			<button type="button" data-steady aria-pressed="false" {...sx(styles.steady)}>Steady</button>
		</aside>
	</div>
</LabLayout>

<script>
	import { startDeck } from "@/lab/sea-legs/deck";

	for (const root of document.querySelectorAll<HTMLElement>("[data-sea-legs]")) startDeck(root);

	for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-sea-video]")) {
		video.addEventListener("playing", () => video.setAttribute("data-playing", ""), { once: true });
		video.src = video.dataset.src ?? "";
		video.play().catch(() => {});
	}
</script>
