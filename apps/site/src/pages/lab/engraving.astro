---
import { getImage } from "astro:assets";
import barge from "@/assets/hero/barge-from-afar.jpg";
import Footer from "@/components/footer/Footer.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import { figureMarker, noticeMarker, styles } from "@/lab/engraving/Engraving.styles";
import LabLayout from "@/lab/LabLayout.astro";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const HORIZON = 0.178;
/** Same-origin, so WebGL can always read it; the CMS poster and video need the CDN to allow this origin. */
const local = (await getImage({ src: barge, width: 1920 })).src;
const still = home.heroPoster?.src ?? local;

const NUMERALS = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const plate = (n: number) => `Plate ${NUMERALS[n] ?? n + 1}`;
const nav = [
	{ label: "Plates", href: "#plates" },
	{ label: "Notices", href: "#notices" },
	{ label: "Newsletter", href: "#newsletter" },
];
const terms = [
	{ value: "12 nmi", label: "Territorial sea ends" },
	{ value: "200 nmi", label: "Economic zone ends" },
	{ value: "Beyond", label: "The high seas" },
];
---

<LabLayout slug="engraving" tone="light">
	<div {...sx(styles.page)}>
		<div {...sx(styles.gutter, styles.headerWrap)}>
			<header {...sx(styles.measure, styles.header)}>
				<a href="/lab/engraving" {...sx(styles.wordmark)}>{site.title}</a>
				<nav aria-label="Main" {...sx(styles.nav)}>
					{nav.map(({ label, href }) => <a href={href} {...sx(styles.navLink)}>{label}</a>)}
				</nav>
			</header>
		</div>

		<main>
			<section aria-label="Intro" data-engraving-hero {...sx(styles.hero)}>
				<div {...sx(styles.stage)}>
					<img src={still} alt="The barge alone on open sea, seen from far above" {...sx(styles.fill, styles.still)} style={{ objectPosition: `50% ${HORIZON * 100}%` }} />
					<canvas
						aria-hidden="true"
						data-plate="hero"
						data-src={still}
						data-local={local}
						data-video={home.heroVideo}
						data-horizon={HORIZON}
						{...sx(styles.fill, styles.canvas)}
					></canvas>
					<div {...sx(styles.titleBlock)}>
						<p {...sx(styles.eyebrow)}>{site.tagline}</p>
						<h1 {...sx(styles.title)}>{site.title}</h1>
						<div aria-hidden="true" {...sx(styles.titleRule)}></div>
						<p {...sx(styles.subtitle)}>Prospectus of a voyage past the last border</p>
					</div>
					<div {...sx(styles.lettering)}>
						<p {...sx(styles.plateNo)}>{plate(0)}</p>
						<p {...sx(styles.plateTitle)}>The vessel, from the air</p>
						<p aria-hidden="true" {...sx(styles.hint)}>Scroll to develop the plate</p>
					</div>
				</div>
			</section>

			<section aria-labelledby="prospectus-heading" {...sx(styles.gutter, styles.section)}>
				<div {...sx(styles.measure)}>
					<div {...sx(styles.sectionHead)}>
						<p {...sx(styles.eyebrow)}>The proposal</p>
						<h2 id="prospectus-heading" {...sx(styles.heading)}>Where the charts leave off</h2>
						<div aria-hidden="true" {...sx(styles.headRule)}></div>
					</div>
					<div {...sx(styles.prospectus)}>
						<p {...sx(styles.para, styles.dropCap)}>
							Every coast draws its lines on the water. Twelve nautical miles out, a nation's territory ends. Two hundred
							miles out, so does its claim on what swims and lies beneath. Past that the old charts simply say: high seas.
						</p>
						<p {...sx(styles.para)}>
							Seasteading is the proposal to live there. Not to visit or to cross, but to build homes that float, and
							settlements that answer to the people aboard them.
						</p>
						<p {...sx(styles.para)}>
							This film follows the ones who have tried. What they built, what the sea made of it, and what it costs to
							start again somewhere no one has drawn a border.
						</p>
					</div>
					<dl {...sx(styles.terms)}>
						{terms.map(({ value, label }) => (
							<div {...sx(styles.term)}>
								<dd {...sx(styles.termValue)}>{value}</dd>
								<dt {...sx(styles.termLabel)}>{label}</dt>
							</div>
						))}
					</dl>
				</div>
			</section>

			{clips.length > 0 && (
				<section id="plates" aria-labelledby="plates-heading" {...sx(styles.gutter, styles.section)}>
					<div {...sx(styles.measure)}>
						<div {...sx(styles.sectionHead)}>
							<p {...sx(styles.eyebrow)}>From the film</p>
							<h2 id="plates-heading" {...sx(styles.heading)}>Plates</h2>
							<div aria-hidden="true" {...sx(styles.headRule)}></div>
						</div>
						<ul {...sx(styles.plates)}>
							{clips.map(({ title, url, thumbnail }, i) => (
								<li>
									<a href={url} target="_blank" rel="noopener" aria-label={`Play ${title}`} {...sx(styles.plateLink)}>
										<figure data-plate-figure {...sx(figureMarker)}>
											<div {...sx(styles.frame)}>
												{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.fill, styles.poster)} />}
												{thumbnail && <canvas aria-hidden="true" data-plate="clip" data-src={thumbnail} {...sx(styles.fill, styles.canvas)}></canvas>}
												<span aria-hidden="true" {...sx(styles.play)}>
													<svg viewBox="0 0 12 14" {...sx(styles.triangle)}><path d="M0 0v14l12-7z" fill="currentColor" /></svg>
												</span>
											</div>
											<figcaption {...sx(styles.plateCaption)}>
												<span {...sx(styles.plateNo)}>{plate(i + 1)}</span>
												<span {...sx(styles.clipTitle)}>{title}</span>
											</figcaption>
										</figure>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)}

			{press.length > 0 && (
				<section id="notices" aria-labelledby="notices-heading" {...sx(styles.gutter, styles.section)}>
					<div {...sx(styles.measure)}>
						<div {...sx(styles.sectionHead)}>
							<p {...sx(styles.eyebrow)}>Press</p>
							<h2 id="notices-heading" {...sx(styles.heading)}>Notices</h2>
							<div aria-hidden="true" {...sx(styles.headRule)}></div>
						</div>
						<ul {...sx(styles.notices)}>
							{press.map(({ headline, url, outlet, dateLabel, quote }) => (
								<li {...sx(styles.notice)}>
									<a href={url} target="_blank" rel="noopener" {...sx(noticeMarker, styles.noticeLink)}>
										<span>
											<span {...sx(styles.outlet)}>{outlet}</span>
											{dateLabel && <span {...sx(styles.date)}>{dateLabel}</span>}
										</span>
										<span>
											<span {...sx(styles.headline)}>{headline}</span>
											{quote && <span {...sx(styles.quote)}>“{quote}”</span>}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)}

			<div {...sx(styles.board)}>
				<Newsletter home={home} />
			</div>
		</main>
		<div {...sx(styles.board)}>
			<Footer />
		</div>
	</div>
</LabLayout>

<script>
	import { engrave } from "@/lab/engraving/plate";

	engrave();
</script>
