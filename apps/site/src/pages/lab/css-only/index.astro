---
import { styles } from "@/lab/css-only/CssOnly.styles";
import Shell from "@/lab/css-only/Shell.astro";
import { getClips } from "@/lib/clips";
import { NEWSLETTER_ENDPOINT } from "@/lib/newsletter";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, clips, press] = await Promise.all([getSite(), getClips(), getPress()]);

const pad = (n: number) => String(n).padStart(2, "0");
/** Each word with the count of letters before it, for the per-letter stagger. */
const words = site.title.split(" ").map((word, i, all) => ({
	letters: [...word],
	offset: all.slice(0, i).join("").length,
}));
/** Far to near: smaller, paler, slower waves at the horizon. */
const swells = [
	{ top: "0%", w: "5rem", h: "0.25rem", mix: "18%", dur: "26s", lift: "-1vh" },
	{ top: "7%", w: "9rem", h: "0.5rem", mix: "38%", dur: "20s", lift: "-3vh" },
	{ top: "18%", w: "15rem", h: "0.875rem", mix: "58%", dur: "15s", lift: "-6vh" },
	{ top: "36%", w: "24rem", h: "1.375rem", mix: "80%", dur: "11s", lift: "-10vh" },
	{ top: "62%", w: "38rem", h: "2rem", mix: "100%", dur: "8s", lift: "-15vh" },
];
---

<Shell home>
	<main>
		<section aria-label="Intro" {...sx(styles.hero)}>
			<div {...sx(styles.copy)}>
				<h1 aria-label={site.title} {...sx(styles.title)}>
					{
						words.map(({ letters, offset }) => (
							<span aria-hidden="true" data-nojs="word" {...sx(styles.word)} style={`--o: ${offset - 1}`}>
								{letters.map((letter, i) => (
									<span data-nojs="letter" {...sx(styles.letter)} style={`--i: ${offset + i}`}>{letter}</span>
								))}
							</span>
						))
					}
				</h1>
			</div>
			<div aria-hidden="true" {...sx(styles.sea)}>
				{
					swells.map(({ top, w, h, mix, dur, lift }) => (
						<div
							data-nojs="wave swell"
							{...sx(styles.swell)}
							style={`--top: ${top}; --w: ${w}; --h: ${h}; --mix: ${mix}; --dur: ${dur}; --lift: ${lift}`}
						/>
					))
				}
				<svg {...sx(styles.grain)}>
					<filter id="nojs-glitter">
						<feTurbulence type="fractalNoise" baseFrequency="0.004 0.11" numOctaves="2" seed="7" />
						<feColorMatrix type="saturate" values="0" />
					</filter>
					<rect width="100%" height="100%" filter="url(#nojs-glitter)" />
				</svg>
			</div>
			<p {...sx(styles.tagline)}>{site.tagline}</p>
			<p aria-hidden="true" {...sx(styles.cue)}>Scroll to go under</p>
		</section>

		<section {...sx(layout.container, styles.section)}>
			<p data-nojs="rise" {...sx(styles.eyebrow)}>Below the line</p>
			<h2 data-nojs="rise" {...sx(styles.heading)}>Past the last border, the sea belongs to no one.</h2>
			<p data-nojs="rise" {...sx(styles.body)}>
				Seasteading is the attempt to build permanent homes in international waters. This film follows the people
				trying it.
			</p>
		</section>

		{
			clips.length > 0 && (
				<section id="clips" aria-labelledby="clips-heading" {...sx(styles.section)}>
					<div {...sx(layout.container)}>
						<p data-nojs="rise" {...sx(styles.eyebrow)}>From the film</p>
						<h2 id="clips-heading" data-nojs="rise" {...sx(styles.heading)}>Clips</h2>
					</div>
					<div {...sx(styles.reelWrap)}>
						<ul data-nojs="reel" {...sx(styles.reel)}>
							{clips.map(({ title, url, thumbnail }, i) => (
								<li data-nojs="slide" {...sx(styles.slide)}>
									<a href={url} target="_blank" rel="noopener" {...sx(styles.clip)}>
										{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.poster)} />}
										<span {...sx(styles.caption)}>
											<span {...sx(styles.index)}>{pad(i + 1)}</span>
											<span {...sx(styles.clipTitle)}>{title}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		{
			press.length > 0 && (
				<section id="press" aria-labelledby="press-heading" {...sx(layout.container, styles.section)}>
					<p data-nojs="rise" {...sx(styles.eyebrow)}>What they wrote</p>
					<h2 id="press-heading" data-nojs="rise" {...sx(styles.heading)}>Press</h2>
					<ul {...sx(styles.press)}>
						{press.map(({ url, outlet, headline, dateLabel }) => (
							<li data-nojs="rise">
								<a href={url} target="_blank" rel="noopener" {...sx(styles.item)}>
									<span {...sx(styles.outlet)}>{outlet}</span>
									<span {...sx(styles.headline)}>{headline}</span>
									{dateLabel && <span {...sx(styles.date)}>{dateLabel}</span>}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section id="newsletter" aria-labelledby="newsletter-heading" {...sx(layout.container, styles.section)}>
			<p data-nojs="rise" {...sx(styles.eyebrow)}>Join the newsletter</p>
			<h2 id="newsletter-heading" data-nojs="rise" {...sx(styles.heading)}>Word from the water</h2>
			<form data-nojs="signup rise" action={NEWSLETTER_ENDPOINT ?? undefined} method="post" {...sx(styles.form)}>
				<label for="nojs-email" {...sx(styles.srOnly)}>Email address</label>
				<input id="nojs-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required {...sx(styles.input)} />
				<button type="submit" {...sx(styles.submit)}>Subscribe</button>
			</form>
		</section>
	</main>

	<footer {...sx(layout.container, styles.footer)}>
		<p>© {new Date().getFullYear()} {site.title}</p>
		<a href="/lab/css-only/about" {...sx(styles.how)}>This page runs no JavaScript. How →</a>
	</footer>
</Shell>
