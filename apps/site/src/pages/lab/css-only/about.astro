---
import { styles } from "@/lab/css-only/CssOnly.styles";
import Shell from "@/lab/css-only/Shell.astro";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const site = await getSite();
const features = [
	{
		name: "animation-timeline: scroll()",
		use: "The descent: water colour, light shafts and the depth readout follow the scrollbar. Also the header tide and hero parallax.",
		note: "Chrome 115, Safari 26. Else: one tall gradient",
	},
	{
		name: "@property",
		use: "Typed custom properties, so a colour and an integer can be animated: the integer is the depth in metres, printed with a CSS counter.",
		note: "All current browsers",
	},
	{
		name: "animation-timeline: view()",
		use: "Sections surface through blur as they enter; clips swell as they cross the centre of the reel.",
		note: "Chrome 115, Safari 26. Else: always visible",
	},
	{
		name: "@view-transition",
		use: "This page flooded in from below while the title and header travelled across the navigation.",
		note: "Chrome 126, Safari 18.2. Else: plain navigation",
	},
	{
		name: "::scroll-marker, ::scroll-button",
		use: "The dots and arrows on the clip reel are generated by the browser from a scroll-snap list.",
		note: "Chrome 135. Else: swipe only",
	},
	{
		name: "popover, anchor(), @starting-style",
		use: "The phone menu: opened by an attribute, positioned under its button, faded in from its starting style.",
		note: "Popover everywhere; anchoring Chrome 125, Safari 26",
	},
	{
		name: ":has()",
		use: "Hovering one clip quiets the others; the subscribe button wakes when the address is valid.",
		note: "All current browsers",
	},
	{
		name: "sibling-index()",
		use: "Staggers the title's letters by position. Inline indices do the same where it is missing.",
		note: "Chrome 138. Else: inline custom property",
	},
	{
		name: "mask, feTurbulence",
		use: "Every wave edge is one masked box; the glitter on the hero sea is an SVG noise filter.",
		note: "All current browsers",
	},
];
---

<Shell>
	<main {...sx(layout.container, styles.section, styles.about)}>
		<p {...sx(styles.aboutTitle)}>{site.title}</p>
		<h1 {...sx(styles.heading)}>No script. Just the platform.</h1>
		<p {...sx(styles.body)}>
			Nothing in this experiment runs JavaScript. Each effect is a CSS or HTML feature with a fallback that leaves
			a plain, readable page.
		</p>
		<ul {...sx(styles.features)}>
			{
				features.map(({ name, use, note }) => (
					<li data-nojs="rise" {...sx(styles.feature)}>
						<p {...sx(styles.featureName)}>{name}</p>
						<p {...sx(styles.featureUse)}>{use}</p>
						<p {...sx(styles.featureNote)}>{note}</p>
					</li>
				))
			}
		</ul>
	</main>
</Shell>
