---
import Footer from "@/components/footer/Footer.astro";
import Newsletter from "@/components/newsletter/Newsletter.astro";
import { styles, tileMarker } from "@/lab/echo/Echo.styles";
import LabLayout from "@/lab/LabLayout.astro";
import { getClips } from "@/lib/clips";
import { getHome } from "@/lib/home";
import { NAV } from "@/lib/nav";
import { getPress } from "@/lib/press";
import { getSite } from "@/lib/site";
import { sx } from "@/lib/sx";
import { layout } from "@/styles/layout";

const [site, home, clips, press] = await Promise.all([
	getSite(),
	getHome(),
	getClips(),
	getPress(),
]);
const pad = (n: number) => String(n).padStart(2, "0");
const nav = NAV.map(({ label, href }) => ({ label, href: href.replace(/^\//, "") }));
---

<LabLayout slug="echo">
	<div data-echo-root {...sx(styles.root)}>
		<canvas data-echo-canvas aria-hidden="true" {...sx(styles.canvas)}></canvas>

		<header data-echo {...sx(layout.container, styles.header, styles.echo)}>
			<a href="#top" {...sx(styles.wordmark)}>{site.title}</a>
			<nav aria-label="Main" {...sx(styles.nav)}>
				{nav.map(({ label, href }) => <a href={href} {...sx(styles.navLink)}>{label}</a>)}
			</nav>
		</header>

		<main id="top">
			<section aria-label="Intro" {...sx(layout.container, styles.hero)}>
				<div>
					<h1 data-echo="glyphs" {...sx(styles.title, styles.echo)}>{site.title}</h1>
					<p data-echo {...sx(styles.tagline, styles.echo)}>{site.tagline}</p>
				</div>
				<p data-echo-live {...sx(styles.hint)}>
					<span {...sx(styles.hintTouch)}>Tap to sound the water</span>
					<span {...sx(styles.hintFine)}>Click to sound the water</span>
				</p>
			</section>

			<section aria-labelledby="echo-soundings" {...sx(layout.container, styles.section)}>
				<p data-echo {...sx(styles.eyebrow, styles.echo)}>Soundings</p>
				<h2 id="echo-soundings" data-echo="glyphs" {...sx(styles.heading, styles.echo)}>
					Out here, you find things by listening.
				</h2>
				<p data-echo {...sx(styles.body, styles.echo)}>
					Light gives out a few hundred metres down. Sound carries on: send a pulse into the dark, wait, and
					what comes back tells you what is there.
				</p>
				<p data-echo {...sx(styles.body, styles.echo)}>
					Two hundred nautical miles from any coast the high seas begin, water that belongs to no nation.
					This film follows the people sounding it out as a place to live.
				</p>
			</section>

			{
				clips.length > 0 && (
					<section id="clips" aria-labelledby="echo-clips" {...sx(layout.container, styles.section)}>
						<p data-echo {...sx(styles.eyebrow, styles.echo)}>Contacts · {pad(clips.length)}</p>
						<h2 id="echo-clips" data-echo="glyphs" {...sx(styles.heading, styles.echo)}>Clips</h2>
						<ul {...sx(styles.grid)}>
							{clips.map(({ title, url, thumbnail }, i) => (
								<li data-echo {...sx(styles.echo, styles.tileItem, i % 2 === 1 && styles.tileLow)}>
									<a href={url} target="_blank" rel="noreferrer" aria-label={`Play ${title}`} {...sx(tileMarker, styles.tile)}>
										<span {...sx(styles.frame)} style={{ display: "block" }}>
											{thumbnail && <img src={thumbnail} alt="" loading="lazy" decoding="async" {...sx(styles.poster)} />}
											<span aria-hidden="true" {...sx(styles.tint)} />
										</span>
										<span {...sx(styles.caption)}>
											<span {...sx(styles.index)}>{pad(i + 1)}</span>
											<span {...sx(styles.clipTitle)}>{title}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				press.length > 0 && (
					<section id="press" aria-labelledby="echo-press" {...sx(layout.container, styles.section)}>
						<p data-echo {...sx(styles.eyebrow, styles.echo)}>Returns</p>
						<h2 id="echo-press" data-echo="glyphs" {...sx(styles.heading, styles.echo)}>Press</h2>
						<ul {...sx(styles.list)}>
							{press.map(({ headline, url, outlet, dateLabel, quote }) => (
								<li data-echo {...sx(styles.echo)}>
									<a href={url} target="_blank" rel="noreferrer" {...sx(tileMarker, styles.item)}>
										<span {...sx(styles.outlet)}>
											{outlet}
											{dateLabel && <span {...sx(styles.date)}>{dateLabel}</span>}
										</span>
										<span>
											<span {...sx(styles.headline)} style={{ display: "block" }}>{headline}</span>
											{quote && <span {...sx(styles.quote)} style={{ display: "block" }}>“{quote}”</span>}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<div data-echo {...sx(styles.echo)}>
				<Newsletter home={home} />
			</div>
		</main>

		<div data-echo {...sx(styles.echo)}>
			<Footer />
		</div>

		<div data-echo-live {...sx(styles.hud)}>
			<span aria-hidden="true" data-echo-count>00/00</span>
			<span aria-hidden="true" data-echo-readout {...sx(styles.readout)}>— m · —°</span>
			<button type="button" data-echo-ui data-echo-sound aria-pressed="false" {...sx(styles.sound)}>Sound off</button>
		</div>
	</div>
</LabLayout>

<script>
	import { startEcho } from "@/lab/echo/echo.client";

	const root = document.querySelector<HTMLElement>("[data-echo-root]");
	if (root) startEcho(root);
</script>
